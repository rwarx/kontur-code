{
    "name": "kontur-code-electron",
    "version": "0.1.1-alpha",
    "private": true,
    "description": "Kontur Code вЂ” Electron shell over the ported new-interface renderer and the .NET sidecar backend",
    "main": "main/main.js",
    "author": "Kontur Code contributors",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rwarx/kontur-code.git"
    },
    "homepage": "https://github.com/rwarx/kontur-code#readme",
    "bugs": {
        "url": "https://github.com/rwarx/kontur-code/issues"
    },
    "build": {
        "appId": "com.kontur.code",
        "productName": "Kontur Code",
        "directories": {
            "output": "release"
        },
        "files": [
            "main/**/*",
            "preload/**/*",
            "dist/renderer/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "sidecar/AIClient.Server.exe",
                "to": "sidecar/AIClient.Server.exe"
            }
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Kontur Code"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "rwarx",
                "repo": "kontur-code"
            }
        ]
    },
    "scripts": {
        "dev": "vite",
        "build:renderer": "vite build",
        "typecheck": "tsc --noEmit",
        "typecheck:shell": "tsc -p tsconfig.shell.json --noEmit",
        "typecheck:all": "npm run typecheck && npm run typecheck:shell",
        "start": "electron .",
        "pack": "electron-builder --win --publish never",
        "dist": "npm run build:renderer && electron-builder --win --publish never"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/language": "^6.12.4",
        "@codemirror/legacy-modes": "^6.5.4",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.13",
        "@lezer/highlight": "^1.2.4",
        "@radix-ui/react-slider": "^1.3.5",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-toast": "^1.2.14",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.525.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.3.1",
        "zustand": "^5.0.6"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.4",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "electron": "^44.0.0",
        "electron-builder": "^26.0.0",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.3.5",
        "typescript": "^5.5.0",
        "vite": "^7.2.0"
    }
}
