<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AIClient.App</RootNamespace>
    <AssemblyName>AIClient</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Single instance + high DPI handled via app.manifest -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIClient.Application\AIClient.Application.csproj" />
    <ProjectReference Include="..\AIClient.Domain\AIClient.Domain.csproj" />
    <!--
      The App references Infrastructure ONLY to compose the DI container in
      Bootstrapper/ServiceRegistration. Views and ViewModels must never
      reference an AIClient.Infrastructure type directly - they resolve
      abstractions declared in Application/Domain.
    -->
    <ProjectReference Include="..\AIClient.Infrastructure\AIClient.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!--
    Inter, bundled. A developer tool is read at 11-13px all day; the app owns its face
    instead of trusting whatever Segoe build the host machine has. OFL licence included
    beside the files. WPF composes weights from the family name, so one Resource pattern
    covers Regular/Medium/SemiBold/Bold plus the italic.
  -->
  <ItemGroup>
    <Resource Include="Fonts\Inter-*.ttf" />
    <None Include="Fonts\OFL-Inter.txt" />
  </ItemGroup>

  <!-- The project's own brand: the logo every brand plate shows, and the compiled
       application icon Explorer and the taskbar display. -->
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
