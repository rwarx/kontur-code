<Application x:Class="AIClient.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        No StartupUri: the main window is resolved from the DI container in
        App.OnStartup, after the host has started and the database has been migrated.
        Letting WPF construct the window itself would mean a parameterless MainWindow
        that reaches for services on its own.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    ThemesDictionary is replaced at runtime by ApplicationThemeManager
                    when the user switches theme or Windows changes its own.
                -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <!--
                    The Kontur design system. Merged after WPF-UI's dictionaries so the
                    product's own tokens and control styles take precedence over the
                    framework defaults for everything inside the window, while WPF-UI
                    keeps the window chrome (caption buttons, dialogs, snackbars).
                    The legacy Shared.xaml and MarkdownTemplates.xaml below still serve
                    the views not yet migrated onto the design system; their brush keys
                    resolve into the design system's legacy aliases.
                -->
                <ResourceDictionary Source="pack://application:,,,/Resources/Design/Theme.xaml" />

                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/Converters.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/Shared.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/MarkdownTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
