    <!-- ===== First run ===== -->
    <sys:String x:Key="S.FirstRun.Step">Step {0} of 3</sys:String>
    <sys:String x:Key="S.FirstRun.Welcome.Title">Welcome to AI Client</sys:String>
    <sys:String x:Key="S.FirstRun.Welcome.Intro">A desktop client for working with AI models. Bring your own API key from a provider you already use — conversations and settings stay on this machine.</sys:String>
    <sys:String x:Key="S.FirstRun.Welcome.Get.Title">What you get</sys:String>
    <sys:String x:Key="S.FirstRun.Welcome.Get.1">• Streaming answers with Markdown and syntax highlighting</sys:String>
    <sys:String x:Key="S.FirstRun.Welcome.Get.2">• Conversations saved locally and searchable</sys:String>
