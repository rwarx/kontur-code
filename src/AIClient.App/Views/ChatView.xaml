<UserControl x:Class="AIClient.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             xmlns:views="clr-namespace:AIClient.App.Views"
              xmlns:kontur="clr-namespace:AIClient.App.Controls"
              xmlns:md="clr-namespace:AIClient.App.Markdown"
              xmlns:motion="clr-namespace:AIClient.App.Controls"
              xmlns:dto="clr-namespace:AIClient.Application.DTOs;assembly=AIClient.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>

        <!--
            One line of a diff. Shared by the approval card and the tool-call cards, and defined before
            both of them: a StaticResource cannot look forward.

            A Border per line rather than a coloured run, because the tint has to reach the full width
            of the card - a green patch that stops at the end of the text makes a short added line look
            like a partial change.
        -->
        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type vm:DiffLine}">
            <Border Padding="6,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!--
                    Never wrapped. The first character of a diff line is what it means, so a line
                    folded onto a second row would show text with no marker in front of it.
                -->
                <TextBlock Text="{Binding Text}"
                           FontFamily="{StaticResource CodeFont}"
                           FontSize="12"
                           TextWrapping="NoWrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Notice">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!--
            One tool call, under the step that asked for it.

            The header is always there, in every state, and the result is behind a chevron that only
            appears when there is a result to show. An Expander would have been less code, but it
            offers an arrow on a card with nothing under it, and greying that arrow out greys the
            headline with it - the one line the card exists to show.
        -->
        <DataTemplate x:Key="ToolCallTemplate" DataType="{x:Type vm:AgentToolCallViewModel}">
            <Border Margin="0,4,0,0"
                    Padding="9,6"
                    CornerRadius="{StaticResource CardCorner}"
                    Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The tool's own name, which the summary usually replaces in the headline. -->
                        <Border Grid.Column="0" Style="{StaticResource KcBadge}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ToolName}"
                                       Style="{StaticResource KcBadgeText}"
                                       FontFamily="{StaticResource CodeFont}" />
                        </Border>

                        <!--
                            Marks the calls that did something rather than looked at something, so a
                            long run can be scanned for the ones that matter. Absent for a read, and
                            absent for a restored card, which no longer knows.
                        -->
                        <Border Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource KcBadge}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Risk}" Value="Write">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Risk}" Value="Execute">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KcBadgeText}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Risk}" Value="Write">
                                                <Setter Property="Text" Value="changed files" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="Execute">
                                                <Setter Property="Text" Value="ran a program" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!--
                            Trimmed, never wrapped. A summary is one line by construction, and a card
                            that grows a second row as its text arrives makes the transcript jump
                            under whatever the user was reading.
                        -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Headline}"
                                   Style="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="9,0,8,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Headline}" />

                        <TextBlock Grid.Column="3" Text="{Binding StateText}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Type.Metadata}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Proposed">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Denied">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Abandoned">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ToggleButton Grid.Column="4"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      FocusVisualStyle="{StaticResource KcFocusVisual}"
                                      Cursor="Hand"
                                      Background="Transparent"
                                      Padding="4,0"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip="Show what this returned">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <kontur:MorphIcon x:Name="Chevron" First="ChevronDown" Second="ChevronUp"
                                                          IsSecond="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Width="12" Height="12"
                                                          Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Foreground"
                                                    Value="{DynamicResource Brush.TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <!--
                        The result, in one of its two forms. Which one was decided when the body was
                        set, because deciding it here would mean the template guessing at whether a
                        line beginning with a hyphen is a deletion or a bullet.

                        A darker well than the card so the two do not merge, and both forms are
                        capped and scrollable: a diff arrives capped by TextDiff, but a file the
                        agent read arrives however long the file is.
                    -->
                    <Border Margin="0,8,0,0"
                            CornerRadius="{StaticResource Radius.SM}"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.BorderFaint}"
                            BorderThickness="1"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <ScrollViewer MaxHeight="220"
                                          Padding="4,6"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsBodyDiff, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding BodyLines}"
                                              ItemTemplate="{StaticResource DiffLineTemplate}"
                                              Focusable="False" />
                            </ScrollViewer>

                            <!--
                                A TextBox rather than a TextBlock: a tool result is the sort of thing
                                a user wants to copy out - a path, an error, a line of a file - and
                                selection is what makes that possible.
                            -->
                            <TextBox Style="{StaticResource KcInputBare}"
                                     Text="{Binding Body, Mode=OneWay}"
                                     IsReadOnly="True"
                                     MaxHeight="220"
                                     Padding="4,6"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="12"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Visibility="{Binding IsBodyText, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            The error card. An error is a component, not a red block: what failed in one
            sentence, the raw detail folded underneath, and the one action that answers it.
        -->
        <DataTemplate x:Key="ErrorDetailsTemplate">
            <TextBox Text="{Binding}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MaxHeight="180"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource KcInputBare}"
                     FontFamily="{StaticResource CodeFont}"
                     FontSize="12" />
        </DataTemplate>

        <!-- One message. Role decides the shape, status decides the extras. -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
            <Grid Margin="0,0,0,20" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Attachment chips, above the text they were sent with. -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Attachments}"
                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="{Binding IsUser, Converter={StaticResource UserAlignment}}"
                              Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AttachmentChip}">
                                <StackPanel Orientation="Horizontal">
                                    <kontur:KonturIcon Kind="File" Width="12" Height="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Type.Caption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    User message. Shown verbatim in a right-aligned bubble: rendering the
                    user's own markdown would mangle a pasted snippet they are asking about.
                -->
                <Border Grid.Row="1"
                        Style="{StaticResource UserMessageCard}"
                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Inline edit (section 20). -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                    MinWidth="420">
                            <TextBox Text="{Binding EditDraft, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0">
                                <Button Style="{StaticResource KcButtonGhost}"
                                        Content="Cancel"
                                        Padding="12,5"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource KcButtonPrimary}"
                                        Content="Save &amp; resend"
                                        Padding="12,5"
                                        Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Assistant message: model label, then the rendered blocks. -->
                <StackPanel Grid.Row="2"
                            Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="{Binding ModelId}"
                               Style="{StaticResource Type.Metadata}"
                               Margin="0,0,0,6"
                               Visibility="{Binding ModelId, Converter={StaticResource StringToVisibility}}" />

                    <!-- Thinking state: something is on screen before the first token lands,
                         and the sparkle breathes while it waits - waiting made visible without
                         a spinner the eye has to chase. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,6"
                                Visibility="{Binding IsAwaitingFirstToken, Converter={StaticResource BoolToVisibility}}">
                        <kontur:KonturIcon Kind="Sparkle" Width="13" Height="13"
                                           Foreground="{DynamicResource Brush.AccentText}"
                                           VerticalAlignment="Center"
                                           motion:Motion.Pulse="True" />
                        <TextBlock Text="ThinkingвЂ¦" Style="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!--
                        What the model said it was thinking, when the provider sends it. Above the
                        answer because that is the order it happened in, and collapsed because it is
                        working out rather than an answer - and it is not what the model will be shown
                        of its own turn on the next step.
                    -->
                    <Expander Margin="0,0,0,8"
                              IsExpanded="{Binding IsReasoningExpanded, Mode=TwoWay}"
                              Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVisibility}}">
                        <Expander.Header>
                            <TextBlock Text="Reasoning" Style="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                        </Expander.Header>

                        <TextBox Text="{Binding Reasoning, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="220"
                                 Margin="0,4,0,0"
                                 Style="{StaticResource KcInputBare}"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto" />
                    </Expander>

                    <!--
                        Rendered markdown. Blocks are reconciled by content hash during
                        streaming, so this ItemsControl only rebuilds the tail.
                    -->
                    <ItemsControl ItemsSource="{Binding Blocks}"
                                  Focusable="False"
                                  Visibility="{Binding IsRenderingMarkdown, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Markdown rendering off: raw text, still selectable. -->
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsRenderingMarkdown, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!--
                        The tools this step asked for, under the text that asked for them. Not
                        virtualised: a step is capped at a handful of calls, and each card lays out
                        its result only once expanded.
                    -->
                    <ItemsControl ItemsSource="{Binding ToolCalls}"
                                  ItemTemplate="{StaticResource ToolCallTemplate}"
                                  Focusable="False"
                                  Margin="0,6,0,0"
                                  Visibility="{Binding HasToolCalls, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!--
                    The error card. A left rule carries the severity so the red is felt before it
                    is read, but the body stays on the panel's own surfaces - a card that looks
                    like an alarm everywhere teaches the eye to skim past alarms.
                -->
                <Border Grid.Row="3"
                        Margin="0,8,0,0"
                        Padding="12,10"
                        CornerRadius="{StaticResource CardCorner}"
                        Background="{DynamicResource Brush.ErrorSoft}"
                        BorderBrush="{DynamicResource Brush.Error}"
                        BorderThickness="2,1,1,1"
                        MaxWidth="{StaticResource ContentMaxWidth}"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <kontur:KonturIcon Kind="Error" Width="14" Height="14"
                                               Foreground="{DynamicResource Brush.Error}"
                                               VerticalAlignment="Top" Margin="0,1,9,0" />
                            <TextBlock Text="Request failed"
                                       Style="{StaticResource Type.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource Type.CaptionWrap}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="23,4,0,0" />

                        <Expander Margin="23,8,0,0"
                                  Visibility="{Binding ErrorTechnicalDetails, Converter={StaticResource StringToVisibility}}">
                            <Expander.Header>
                                <TextBlock Text="Technical details" Style="{StaticResource Type.Metadata}"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </Expander.Header>
                            <TextBox Text="{Binding ErrorTechnicalDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource KcInputBare}"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="12" />
                        </Expander>

                        <Button Style="{StaticResource KcButtonQuiet}" HorizontalAlignment="Left"
                                Margin="23,8,0,0"
                                Visibility="{Binding IsRetryable, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Refresh" Width="11" Height="11"
                                                   VerticalAlignment="Center" />
                                <TextBlock Text="Retry" Style="{StaticResource Type.Metadata}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3"
                           Style="{StaticResource SubtleText}"
                           Text="Generation stopped."
                           Margin="0,6,0,0"
                           Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVisibility}}" />

                <!--
                    Action bar. Visible on hover or while the row is focused, so a scrolled
                    transcript is not a wall of buttons.
                -->
                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                    <Setter Property="Opacity" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Assistant: Copy, Regenerate. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource KcButtonQuiet}"
                                ToolTip="Copy message"
                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Copy" Width="11" Height="11" />
                                <TextBlock Text="Copy" Style="{StaticResource Type.Metadata}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource KcButtonQuiet}" Margin="4,0,0,0"
                                ToolTip="Generate a new answer"
                                Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Refresh" Width="11" Height="11" />
                                <TextBlock Text="Regenerate" Style="{StaticResource Type.Metadata}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource KcButtonQuiet}" Margin="4,0,0,0"
                                ToolTip="Delete message"
                                Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <kontur:KonturIcon Kind="Trash" Width="11" Height="11" />
                        </Button>

                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource UsageSummary}">
                                    <Binding Path="InputTokens" />
                                    <Binding Path="OutputTokens" />
                                    <Binding Path="GenerationTimeMs" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <!-- User: Edit, Delete. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource KcButtonQuiet}"
                                Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Edit" Width="11" Height="11" />
                                <TextBlock Text="Edit" Style="{StaticResource Type.Metadata}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource KcButtonQuiet}" Margin="4,0,0,0"
                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Copy" Width="11" Height="11" />
                                <TextBlock Text="Copy" Style="{StaticResource Type.Metadata}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource KcButtonQuiet}" Margin="4,0,0,0"
                                ToolTip="Delete message"
                                Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <kontur:KonturIcon Kind="Trash" Width="11" Height="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Starter card: a suggestion is one quiet row, not a button that shouts. -->
        <Style x:Key="SuggestionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

    </UserControl.Resources>

    <Grid md:MarkdownHost.HighlightCode="{Binding HighlightCode}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Transcript -->
        <ScrollViewer x:Name="TranscriptScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,16,0,8"
                      ScrollChanged="OnTranscriptScrollChanged">
            <Grid MaxWidth="{StaticResource ContentMaxWidth}" Margin="24,0">
                <!--
                    VirtualizingStackPanel: a long conversation is hundreds of message
                    subtrees, and realising all of them is exactly the "thousands of heavy UI
                    elements" section 27 warns about. Recycling keeps scrolling smooth.
                -->
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplate="{StaticResource MessageTemplate}"
                              Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty state (section 33): never a blank grey panel. The one surface
                     that may speak in the display voice, arriving with a single rise. -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,40"
                            motion:Motion.Show="Rise"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                    <kontur:KonturIcon Kind="Sparkle" Width="26" Height="26" GlyphThickness="2.7"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       HorizontalAlignment="Center" Margin="0,0,0,14" />

                    <TextBlock Text="What can I help you with?"
                               Style="{StaticResource Type.Display}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Ask a question, paste some code, or attach a file."
                               Style="{StaticResource Type.Caption}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28" />

                    <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="720" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SuggestionButton}" Margin="4"
                                        Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Type.Metadata}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Jump-to-bottom, shown once the user has scrolled away from the tail. -->
        <Button Grid.Row="0"
                Style="{StaticResource KcButtonGhost}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,12"
                Padding="10,5"
                Click="OnJumpToLatest"
                Visibility="{Binding IsScrolledAway, Converter={StaticResource BoolToVisibility}}">
            <Button.Background>
                <DynamicResource ResourceKey="Brush.Surface3" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <kontur:KonturIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="Jump to latest" Style="{StaticResource Type.Metadata}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!--
            The approval gate (section 28). Docked above the composer rather than raised as a modal
            dialog, because the answer depends on the transcript behind it - which file the model said
            it was editing, what it claimed to have read - and a window centred over that text would
            hide the evidence the user needs.
        -->
        <Border Grid.Row="1"
                Margin="24,0,24,0"
                Padding="14,12"
                CornerRadius="{StaticResource CardCorner}"
                Background="{DynamicResource Brush.Surface2}"
                BorderThickness="3,1,1,1"
                BorderBrush="{DynamicResource ApprovalAccentBrush}"
                MaxWidth="{StaticResource ContentMaxWidth}"
                motion:Motion.Show="Rise"
                Visibility="{Binding Approval.IsAsking, Converter={StaticResource BoolToVisibility}}">

            <!--
                Bound to the pending question rather than to the chat pane. When there is no question
                the card is collapsed, so the null DataContext underneath is never rendered.
            -->
            <Grid DataContext="{Binding Approval.Pending}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- What is being asked, and what it costs if the answer is yes. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <kontur:KonturIcon Grid.Column="0"
                                       Kind="Warning"
                                       Width="16" Height="16"
                                       Margin="0,1,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource ApprovalAccentBrush}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Headline}"
                                   Style="{StaticResource Type.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Consequence}"
                                   Style="{StaticResource Type.CaptionWrap}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextTrimming="None"
                                   Margin="0,2,0,0" />

                        <!--
                            Shown when the same call is asked about twice in one run. Without it the
                            user is left wondering whether they misread the previous question.
                        -->
                        <TextBlock Text="You already allowed this exact call in this run. It is being asked again because answers to this kind of call are deliberately not remembered."
                                   Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsRepeat, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource KcBadge}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ToolName}" Style="{StaticResource KcBadgeText}"
                                   FontFamily="{StaticResource CodeFont}" />
                    </Border>
                </Grid>

                <!--
                    The diff. Not virtualised on purpose: TextDiff caps a preview at four hundred
                    lines, so the worst case is a few hundred short TextBlocks, and the panel a
                    ScrollViewer would need to virtualise costs more than it saves at that size.
                -->
                <Border Grid.Row="1"
                        Style="{StaticResource CodeBlockContainer}"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer MaxHeight="240"
                                  Padding="4,6"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PreviewLines}"
                                      ItemTemplate="{StaticResource DiffLineTemplate}"
                                      Focusable="False" />
                    </ScrollViewer>
                </Border>

                <!--
                    The raw call, collapsed. Rarely the thing the decision turns on, and the one place
                    to look when the summary and the diff disagree with each other.
                -->
                <Expander Grid.Row="2"
                          Margin="0,8,0,0"
                          IsExpanded="{Binding IsArgumentsExpanded, Mode=TwoWay}"
                          Visibility="{Binding HasArguments, Converter={StaticResource BoolToVisibility}}">
                    <Expander.Header>
                        <TextBlock Text="Arguments" Style="{StaticResource Type.Metadata}"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </Expander.Header>

                    <TextBox Text="{Binding ArgumentsJson, Mode=OneWay}"
                             IsReadOnly="True"
                             MaxHeight="140"
                             Margin="0,4,0,0"
                             Style="{StaticResource KcInputBare}"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Expander>

                <!--
                    The answer. The reason sits next to Don't allow because that is the only button it
                    changes: it is sent to the model in place of the loop's plain refusal, and turns
                    "no" into a correction the model can act on in one step.
                -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.SM}"
                            Margin="0,0,10,0"
                            MinHeight="30">
                        <TextBox Style="{StaticResource KcInputBare}"
                                 Text="{Binding DenyReason, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Why not? Optional, and sent to the model."
                                 VerticalContentAlignment="Center"
                                 Margin="8,0" />
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource KcButtonGhost}"
                                Content="Don't allow"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Command="{Binding DenyCommand}" />

                        <Button Style="{StaticResource KcButtonGhost}"
                                Content="Allow for this run"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Command="{Binding AllowForRunCommand}"
                                Visibility="{Binding CanAllowForRun, Converter={StaticResource BoolToVisibility}}" />

                        <Button Style="{StaticResource KcButtonPrimary}"
                                Content="Allow once"
                                Padding="12,5"
                                Command="{Binding AllowCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Composer -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.BorderFaint}"
                Background="{DynamicResource Brush.Surface1}"
                Padding="24,12,24,14">
            <Grid MaxWidth="{StaticResource ContentMaxWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Transient notice: attachment rejected, export written, model not chosen.
                    A notice, not an alarm - warning tint, quiet text, and one quiet X.
                -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.WarningSoft}"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="2,1,1,1"
                        CornerRadius="{StaticResource Radius.SM}"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsBannerOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <kontur:KonturIcon Grid.Column="0" Kind="Warning" Width="13" Height="13"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           VerticalAlignment="Top" Margin="0,1,9,0" />
                        <TextBlock Grid.Column="1" Text="{Binding BannerMessage}"
                                   Style="{StaticResource Type.CaptionWrap}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource KcButtonTool}" Width="22" Height="22"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DismissBannerCommand}"
                                ToolTip="Dismiss">
                            <kontur:KonturIcon Kind="Close" Width="10" Height="10" GlyphThickness="2.7" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Staged attachments as removable chips (section 19). -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding PendingAttachments}"
                              Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AttachmentChip}">
                                <StackPanel Orientation="Horizontal">
                                    <kontur:KonturIcon Kind="File" Width="12" Height="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Type.Caption}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplaySize}"
                                               Style="{StaticResource Type.Metadata}"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="truncated"
                                               Style="{StaticResource Type.Metadata}"
                                               FontStyle="Italic"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource KcButtonQuiet}" Padding="2,0" Margin="7,0,0,0"
                                            ToolTip="Remove attachment"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <kontur:KonturIcon Kind="Close" Width="10" Height="10" GlyphThickness="2.7" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    The composer is one control: a single framed surface holding the draft, with
                    the actions in a footer row. Focus belongs to the frame, not to the text
                    inside it, which is why the border lights rather than the well.
                -->
                <Border Grid.Row="2"
                        x:Name="ComposerFrame"
                        CornerRadius="{StaticResource Radius.MD}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border}"
                        Background="{DynamicResource Brush.SurfaceSunken}"
                        Padding="4"
                        AllowDrop="True"
                        Drop="OnFilesDropped"
                        DragOver="OnFilesDragOver">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="DraftBox"
                                 Grid.Row="0"
                                 Style="{StaticResource KcInputBare}"
                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinLines="1"
                                 MaxLines="12"
                                 MaxHeight="240"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8,7"
                                 PreviewKeyDown="OnDraftKeyDown"
                                 SpellCheck.IsEnabled="True" />

                        <!-- The composer's own footer: tools left, send right. -->
                        <Grid Grid.Row="1" Margin="4,2,4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource KcButtonTool}" Width="26" Height="24"
                                    ToolTip="Attach a file"
                                    Command="{Binding AttachFilesCommand}">
                                <kontur:KonturIcon Kind="Paperclip" Width="13" Height="13" />
                            </Button>

                            <!--
                                Agent mode, and which kind of run, in one button. Both are one question -
                                what pressing Send does with this message - so they are one control, and it
                                is in the composer rather than in Settings because the answer changes from
                                message to message: plan, read the plan, then build.

                                A plain button rather than a toggle: every state here is chosen from the
                                menu, including off, so a click can never change what Send does by itself.
                                The caption carries the answer, because a control whose menu is shut has to
                                say what it is set to.
                            -->
                            <Button Grid.Column="1"
                                    x:Name="AgentButton"
                                    Content="{Binding AgentButtonText}"
                                    ToolTip="Let the model work on the project. It plans by default, and asks before anything it cannot take back."
                                    Click="OnAgentButtonClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KcButtonGhost}">
                                        <Setter Property="FontSize" Value="{StaticResource Size.Metadata}" />
                                        <Setter Property="Padding" Value="9,3" />
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="4,0,0,0" />
                                        <Style.Triggers>
                                            <!-- Accented while it is on, which is the one state worth seeing from across the room. -->
                                            <DataTrigger Binding="{Binding IsAgentMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ContextMenu>
                                    <!--
                                        Ordered by how much each mode changes, planning first, for the same
                                        reason the tool registry orders tools by risk: the first plausible
                                        entry is the one that gets picked.

                                        Each entry says what it costs on a second line rather than in a
                                        tooltip, because the difference between these four is the whole of
                                        the decision and nobody hovers a menu they are already reading.

                                        IsChecked is bound to one string rather than to three comparisons of
                                        the mode, so exactly one item can ever be marked - including Off,
                                        which is a state of this control as much as the other three are. It
                                        is one-way, and IsCheckable is left false: a click that set its own
                                        check would overwrite the binding for good.
                                    -->
                                    <ContextMenu>
                                        <MenuItem Command="{Binding SetAgentModeCommand}"
                                                  CommandParameter="{x:Static dto:AgentMode.Plan}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=Plan}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Plan" />
                                                    <TextBlock Text="Reads and works out what to do. Changes nothing."
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>

                                        <MenuItem Command="{Binding SetAgentModeCommand}"
                                                  CommandParameter="{x:Static dto:AgentMode.PlanCanvas}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=PlanCanvas}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Plan + canvas" />
                                                    <TextBlock Text="Plans, and draws the project it would build."
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>

                                        <MenuItem Command="{Binding SetAgentModeCommand}"
                                                  CommandParameter="{x:Static dto:AgentMode.Build}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=Build}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Build" />
                                                    <TextBlock Text="Carries the work out, asking before each change."
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>

                                        <Separator />

                                        <MenuItem Command="{Binding TurnAgentOffCommand}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=Off}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Off" />
                                                    <TextBlock Text="One answer from the model, no tools."
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!--
                                The model for this conversation, chosen where the conversation happens
                                rather than up in the title bar: which model answers is part of the
                                message, like the agent mode beside it. The caption carries the current
                                choice; the flyout is the same picker the rest of the app uses, bound to
                                the one shared ModelPicker on the shell so a choice made here, in Settings,
                                or at first run is always the same selection.
                            -->
                            <Button Grid.Column="2"
                                    x:Name="ModelPill"
                                    Style="{StaticResource KcButtonGhost}"
                                    Padding="9,3"
                                    MinHeight="24"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    ToolTip="Choose the model for this conversation"
                                    Click="OnModelPillClick">
                                <StackPanel Orientation="Horizontal">
                                    <kontur:KonturIcon Kind="Models" Width="12" Height="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource Type.Metadata}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedModel.Name, FallbackValue='Model', TargetNullValue='Model'}" />
                                    <kontur:KonturIcon Kind="ChevronDown" Width="10" Height="10" GlyphThickness="2.7"
                                                       VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>

                            <!--
                                Placed above the pill: the composer sits at the bottom of the window, so a
                                flyout opening downward would fall off-screen. DataContext reaches past the
                                chat VM to the shell's shared ModelPicker.
                            -->
                            <Popup x:Name="ModelPopup"
                                   PlacementTarget="{Binding ElementName=ModelPill}"
                                   Placement="Top"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Surface3}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.LG}"
                                        Margin="8"
                                        Padding="4"
                                        Effect="{StaticResource Shadow.Overlay}">
                                    <views:ModelPickerView x:Name="ModelPicker"
                                                           Width="440" MaxHeight="460"
                                                           DataContext="{Binding DataContext.ModelPicker, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Border>
                            </Popup>

                            <!-- Send and Stop are one button: the state decides what it
                                  does, and the icon folds between the paper plane and the
                                  square rather than two buttons trading places. -->
                            <Button Grid.Column="4"
                                    Width="30" Height="26"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KcButtonPrimary}">
                                        <Setter Property="Command" Value="{Binding SendCommand}" />
                                        <Setter Property="ToolTip" Value="Send (Enter)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                <Setter Property="Command" Value="{Binding StopCommand}" />
                                                <Setter Property="ToolTip" Value="Stop generating (Esc)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <kontur:MorphIcon First="Send" Second="Stop"
                                                  IsSecond="{Binding IsGenerating}"
                                                  Width="13" Height="13"
                                                  Foreground="{DynamicResource Brush.TextOnAccent}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="4,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource SubtleText}"
                               Text="{Binding InputHint}" />

                    <!-- What the next message will do, and where, while it is still possible not to send. -->
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource SubtleText}"
                               Text="{Binding AgentHint}"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource ApprovalAccentBrush}"
                               Visibility="{Binding IsAgentMode, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
