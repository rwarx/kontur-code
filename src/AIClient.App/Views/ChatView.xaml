<UserControl x:Class="AIClient.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             xmlns:md="clr-namespace:AIClient.App.Markdown"
             xmlns:dto="clr-namespace:AIClient.Application.DTOs;assembly=AIClient.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>

        <!--
            One line of a diff. Shared by the approval card and the tool-call cards, and defined before
            both of them: a StaticResource cannot look forward.

            A Border per line rather than a coloured run, because the tint has to reach the full width
            of the card - a green patch that stops at the end of the text makes a short added line look
            like a partial change. The leading character still carries the meaning for anyone who
            cannot tell the two hues apart; the tint decides the background, the text colour follows
            the line kind so added and removed words stay readable in both themes.
        -->
        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type vm:DiffLine}">
            <Border Padding="8,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!--
                    Never wrapped. The first character of a diff line is what it means, so a line
                    folded onto a second row would show text with no marker in front of it.
                -->
                <TextBlock Text="{Binding Text}"
                           FontFamily="{StaticResource CodeFont}"
                           FontSize="12"
                           TextWrapping="NoWrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                    <Setter Property="Foreground" Value="{DynamicResource DiffAddedTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                    <Setter Property="Foreground" Value="{DynamicResource DiffRemovedTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Notice">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!--
            One tool call, under the step that asked for it, drawn as an execution-timeline row:
            a status dot, the tool's name in mono, what it did, and where it ended up. The header
            is always there, in every state, and the result is behind a chevron that only appears
            when there is a result to show. An Expander would have been less code, but it offers
            an arrow on a card with nothing under it, and greying that arrow out greys the
            headline with it - the one line the card exists to show.
        -->
        <DataTemplate x:Key="ToolCallTemplate" DataType="{x:Type vm:AgentToolCallViewModel}">
            <Border Style="{StaticResource ToolCallCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            The dot is the state, and it reads before the words do: quiet while
                            waiting, accent while working, green done, red failed, amber for the
                            two human-interrupted ends.
                        -->
                        <Ellipse Grid.Column="0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource ToolStatusDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Proposed">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Denied">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Abandoned">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- The tool's own name, which the summary usually replaces in the headline. -->
                        <Border Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ToolName}"
                                       Style="{StaticResource BadgeText}"
                                       FontFamily="{StaticResource CodeFont}" />
                        </Border>

                        <!--
                            Marks the calls that did something rather than looked at something, so a
                            long run can be scanned for the ones that matter. Absent for a read, and
                            absent for a restored card, which no longer knows.
                        -->
                        <Border Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Risk}" Value="Write">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Risk}" Value="Execute">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Risk}" Value="Write">
                                                <Setter Property="Text" Value="{DynamicResource S.Tool.Risk.Write}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="Execute">
                                                <Setter Property="Text" Value="{DynamicResource S.Tool.Risk.Execute}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!--
                            Trimmed, never wrapped. A summary is one line by construction, and a card
                            that grows a second row as its text arrives makes the transcript jump
                            under whatever the user was reading.
                        -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Headline}"
                                   Margin="8,0,8,0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Headline}" />

                        <TextBlock Grid.Column="4" Text="{Binding StateText}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Proposed">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Denied">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Abandoned">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ToggleButton Grid.Column="5"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="4,0"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip="{DynamicResource S.Chat.ShowResult.ToolTip}">
                            <ui:SymbolIcon FontSize="14" Foreground="{DynamicResource TextMutedBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ChevronDown24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Symbol" Value="ChevronUp24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ToggleButton>
                    </Grid>

                    <!--
                        The result, in one of its two forms. Which one was decided when the body was
                        set, because deciding it here would mean the template guessing at whether a
                        line beginning with a hyphen is a deletion or a bullet.

                        An inset well darker than the card so the two do not merge, and both forms
                        are capped and scrollable: a diff arrives capped by TextDiff, but a file the
                        agent read arrives however long the file is.
                    -->
                    <Border Margin="0,8,0,0"
                            CornerRadius="{StaticResource R6}"
                            Background="{DynamicResource BgInsetBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <ScrollViewer MaxHeight="220"
                                          Padding="4,6"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsBodyDiff, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding BodyLines}"
                                              ItemTemplate="{StaticResource DiffLineTemplate}"
                                              Focusable="False" />
                            </ScrollViewer>

                            <!--
                                A TextBox rather than a TextBlock: a tool result is the sort of thing
                                a user wants to copy out - a path, an error, a line of a file - and
                                selection is what makes that possible.
                            -->
                            <TextBox Text="{Binding Body, Mode=OneWay}"
                                     IsReadOnly="True"
                                     MaxHeight="220"
                                     Padding="4,6"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="12"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Visibility="{Binding IsBodyText, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One message. Role decides the shape, status decides the extras. -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
            <Grid Margin="0,0,0,22" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Attachment chips, above the text they were sent with. -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Attachments}"
                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="{Binding IsUser, Converter={StaticResource UserAlignment}}"
                              Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AttachmentChip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    User message. Shown verbatim in a right-aligned compact card: rendering the
                    user's own markdown would mangle a pasted snippet they are asking about.
                -->
                <Border Grid.Row="1"
                        Style="{StaticResource UserMessageCard}"
                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="19"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Inline edit (section 20). -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                    MinWidth="420">
                            <ui:TextBox Text="{Binding EditDraft, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MaxHeight="260"
                                        VerticalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0">
                                <ui:Button Content="{DynamicResource S.Common.Cancel}"
                                           Margin="0,0,6,0"
                                           Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Content="{DynamicResource S.Chat.SaveResend}"
                                           Appearance="Primary"
                                           Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Assistant message: a compact identity row (mark and model), then the answer as a
                    working process - reasoning first if the provider sent it, then the rendered
                    blocks, then the tools this step asked for. No card around it: the answer runs
                    full width, because code that wraps at two-thirds width reads worse.
                -->
                <StackPanel Grid.Row="2"
                            Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8"
                                Visibility="{Binding IsAwaitingFirstToken, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Width="20"
                                Height="20"
                                CornerRadius="{StaticResource R6}"
                                Background="{DynamicResource BgHoverBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Sparkle24"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Border>

                        <TextBlock Style="{StaticResource AssistantMetaText}"
                                   Text="{Binding ModelId}"
                                   Margin="8,3,0,0"
                                   Visibility="{Binding ModelId, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <!-- Thinking state: something is on screen before the first token lands. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,6"
                                Visibility="{Binding IsAwaitingFirstToken, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource S.Chat.Thinking}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!--
                        What the model said it was thinking, when the provider sends it. Above the
                        answer because that is the order it happened in, and collapsed because it is
                        working out rather than an answer - and it is not what the model will be shown
                        of its own turn on the next step.
                    -->
                    <Expander Margin="0,0,0,8"
                              IsExpanded="{Binding IsReasoningExpanded, Mode=TwoWay}"
                              Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVisibility}}">
                        <Expander.Header>
                            <TextBlock Text="{DynamicResource S.Chat.Reasoning}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Expander.Header>

                        <TextBox Text="{Binding Reasoning, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="220"
                                 Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Expander>

                    <!--
                        Rendered markdown. Blocks are reconciled by content hash during
                        streaming, so this ItemsControl only rebuilds the tail.
                    -->
                    <ItemsControl ItemsSource="{Binding Blocks}"
                                  Focusable="False"
                                  Visibility="{Binding IsRenderingMarkdown, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Markdown rendering off: raw text, still selectable. -->
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsRenderingMarkdown, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!--
                        The tools this step asked for, under the text that asked for them. Not
                        virtualised: a step is capped at a handful of calls, and each card lays out
                        its result only once expanded.
                    -->
                    <ItemsControl ItemsSource="{Binding ToolCalls}"
                                  ItemTemplate="{StaticResource ToolCallTemplate}"
                                  Focusable="False"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding HasToolCalls, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Error state with a separate technical section and Retry (section 21). -->
                <ui:InfoBar Grid.Row="3"
                            Severity="Error"
                            IsOpen="{Binding HasFailed, Mode=OneWay}"
                            IsClosable="False"
                            Title="{DynamicResource S.Chat.Failed.Title}"
                            Message="{Binding ErrorMessage}"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,8,0,0">
                        <Expander Header="{DynamicResource S.Common.TechnicalDetails}"
                                  Visibility="{Binding ErrorTechnicalDetails, Converter={StaticResource StringToVisibility}}">
                            <TextBox Text="{Binding ErrorTechnicalDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0" />
                        </Expander>

                        <ui:Button Content="{DynamicResource S.Common.Retry}"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   HorizontalAlignment="Left"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsRetryable, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </ui:InfoBar>

                <TextBlock Grid.Row="3"
                           Style="{StaticResource SubtleText}"
                           Text="{DynamicResource S.Chat.Stopped}"
                           Margin="0,6,0,0"
                           Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVisibility}}" />

                <!--
                    Action bar. Visible on hover or while the row is focused, so a scrolled
                    transcript is not a wall of buttons.
                -->
                <Grid Grid.Row="4" Margin="0,5,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                    <Setter Property="Opacity" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Assistant: Copy, Regenerate. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="{DynamicResource S.Common.Copy}"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   ToolTip="{DynamicResource S.Chat.Copy.ToolTip}"
                                   Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="{DynamicResource S.Chat.Regenerate}"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   ToolTip="{DynamicResource S.Chat.Regenerate.ToolTip}"
                                   Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   ToolTip="{DynamicResource S.Chat.Delete.ToolTip}"
                                   Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />

                        <TextBlock Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource UsageSummary}">
                                    <Binding Path="InputTokens" />
                                    <Binding Path="OutputTokens" />
                                    <Binding Path="GenerationTimeMs" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <!-- User: Edit, Delete. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="{DynamicResource S.Common.Edit}"
                                   Icon="{ui:SymbolIcon Edit24}"
                                   Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="{DynamicResource S.Common.Copy}"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   ToolTip="{DynamicResource S.Chat.Delete.ToolTip}"
                                   Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid md:MarkdownHost.HighlightCode="{Binding HighlightCode}"
          Background="{DynamicResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Transcript -->
        <ScrollViewer x:Name="TranscriptScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,18,0,8"
                      ScrollChanged="OnTranscriptScrollChanged">
            <Grid MaxWidth="{StaticResource ContentMaxWidth}" Margin="26,0">
                <!--
                    VirtualizingStackPanel: a long conversation is hundreds of message
                    subtrees, and realising all of them is exactly the "thousands of heavy UI
                    elements" section 27 warns about. Recycling keeps scrolling smooth.
                -->
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplate="{StaticResource MessageTemplate}"
                              Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty state (section 33): never a blank grey panel. -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,40"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                    <Border Width="46"
                            Height="46"
                            CornerRadius="{StaticResource R12}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <ui:SymbolIcon Symbol="Sparkle24"
                                       FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Border>

                    <TextBlock Text="{DynamicResource S.Chat.Empty.Title}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource FontUiDisplay}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{DynamicResource S.Chat.Empty.Subtitle}"
                               Style="{StaticResource SubtleText}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28" />

                    <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="640" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Style="{StaticResource SuggestionButton}"
                                           Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Jump-to-bottom, shown once the user has scrolled away from the tail. -->
        <ui:Button Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,12"
                   Padding="10,6"
                   CornerRadius="{StaticResource ChipCorner}"
                   Icon="{ui:SymbolIcon ArrowDown24}"
                   Content="{DynamicResource S.Chat.JumpToLatest}"
                   Click="OnJumpToLatest"
                   Visibility="{Binding IsScrolledAway, Converter={StaticResource BoolToVisibility}}" />

        <!--
            The approval gate (section 28). Docked above the composer rather than raised as a modal
            dialog, because the answer depends on the transcript behind it - which file the model said
            it was editing, what it claimed to have read - and a window centred over that text would
            hide the evidence the user needs.
        -->
        <Grid Grid.Row="1"
              Margin="24,0,24,8"
              MaxWidth="{StaticResource ContentMaxWidth}"
              Visibility="{Binding Approval.IsAsking, Converter={StaticResource BoolToVisibility}}">

            <!--
                Bound to the pending question rather than to the chat pane. When there is no question
                the card is collapsed, so the null DataContext underneath is never rendered.
            -->
            <Border Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource R8}"
                    Padding="16,12,14,12">
                <Grid DataContext="{Binding Approval.Pending}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- What is being asked, and what it costs if the answer is yes. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Warning24"
                                       FontSize="17"
                                       Margin="0,1,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource ApprovalAccentBrush}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Headline}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding Consequence}"
                                       Style="{StaticResource SubtleText}"
                                       TextTrimming="None"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />

                            <!--
                                Shown when the same call is asked about twice in one run. Without it the
                                user is left wondering whether they misread the previous question.
                            -->
                            <TextBlock Text="{DynamicResource S.Chat.Repeat}"
                                       Style="{StaticResource SubtleText}"
                                       TextTrimming="None"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ApprovalAccentBrush}"
                                       Visibility="{Binding IsRepeat, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ToolName}"
                                       Style="{StaticResource BadgeText}"
                                       FontFamily="{StaticResource CodeFont}" />
                        </Border>
                    </Grid>

                    <!--
                        The diff. Not virtualised on purpose: TextDiff caps a preview at four hundred
                        lines, so the worst case is a few hundred short TextBlocks, and the panel a
                        ScrollViewer would need to virtualise costs more than it saves at that size.
                    -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CodeBlockContainer}"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer MaxHeight="240"
                                      Padding="4,6"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PreviewLines}"
                                          ItemTemplate="{StaticResource DiffLineTemplate}"
                                          Focusable="False" />
                        </ScrollViewer>
                    </Border>

                    <!--
                        The raw call, collapsed. Rarely the thing the decision turns on, and the one place
                        to look when the summary and the diff disagree with each other.
                    -->
                    <Expander Grid.Row="2"
                              Margin="0,8,0,0"
                              IsExpanded="{Binding IsArgumentsExpanded, Mode=TwoWay}"
                              Visibility="{Binding HasArguments, Converter={StaticResource BoolToVisibility}}">
                        <Expander.Header>
                            <TextBlock Text="{DynamicResource S.Approval.Arguments}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Expander.Header>

                        <TextBox Text="{Binding ArgumentsJson, Mode=OneWay}"
                                 IsReadOnly="True"
                                 MaxHeight="140"
                                 Margin="0,6,0,0"
                                 FontFamily="{StaticResource CodeFont}"
                                 FontSize="12"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Expander>

                    <!--
                        The answer. The reason sits next to Don't allow because that is the only button it
                        changes: it is sent to the model in place of the loop's plain refusal, and turns
                        "no" into a correction the model can act on in one step.
                    -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding DenyReason, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{DynamicResource S.Approval.DenyPlaceholder}"
                                    Margin="0,0,10,0"
                                    MinWidth="0"
                                    VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource S.Approval.Deny}"
                                       Appearance="Secondary"
                                       Padding="12,7"
                                       Margin="0,0,6,0"
                                       Command="{Binding DenyCommand}" />

                            <ui:Button Content="{DynamicResource S.Approval.AllowRun}"
                                       Appearance="Secondary"
                                       Padding="12,7"
                                       Margin="0,0,6,0"
                                       Command="{Binding AllowForRunCommand}"
                                       Visibility="{Binding CanAllowForRun, Converter={StaticResource BoolToVisibility}}" />

                            <ui:Button Content="{DynamicResource S.Approval.AllowOnce}"
                                       Appearance="Primary"
                                       Padding="12,7"
                                       Command="{Binding AllowCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- The amber edge: the one colour the gate owns, so it is findable in a glance. -->
            <Border HorizontalAlignment="Left"
                    Width="3"
                    Margin="0,10"
                    CornerRadius="2"
                    Background="{DynamicResource ApprovalAccentBrush}" />
        </Grid>

        <!-- Composer -->
        <Grid Grid.Row="2" Margin="24,4,24,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MaxWidth="{StaticResource ContentMaxWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Transient notice: attachment rejected, export written, model not chosen. -->
                <ui:InfoBar Grid.Row="0"
                            Severity="Warning"
                            IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                            Message="{Binding BannerMessage}"
                            Margin="0,0,0,8" />

                <!--
                    The command center: one elevated surface holding the staged attachments, the
                    draft, and the controls that decide what Send does. The focus ring is the
                    border turning accent while any part of it owns the keyboard.
                -->
                <Border Grid.Row="1"
                        CornerRadius="{StaticResource R12}"
                        BorderThickness="1"
                        Background="{DynamicResource BgSurfaceBrush}"
                        Padding="6"
                        AllowDrop="True"
                        Drop="OnFilesDropped"
                        DragOver="OnFilesDragOver">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Staged attachments as removable chips (section 19). -->
                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding PendingAttachments}"
                                      Margin="8,6,8,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingAttachments.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AttachmentChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12" />
                                            <TextBlock Text="{Binding DisplaySize}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource S.Chat.Truncated}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontStyle="Italic"
                                                       Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="✕"
                                                    Margin="8,0,0,0"
                                                    Padding="4,0"
                                                    FontSize="11"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTip="{DynamicResource S.Chat.RemoveAttachment.ToolTip}"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox x:Name="DraftBox"
                                 Grid.Row="1"
                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinLines="1"
                                 MaxLines="12"
                                 MaxHeight="240"
                                 Margin="6,2,6,0"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6,8"
                                 PreviewKeyDown="OnDraftKeyDown"
                                 SpellCheck.IsEnabled="True" />

                        <!--
                            The composer toolbar. Left: what Send will do - a mode, not a mystery.
                            Right: the input sources and the trigger.
                        -->
                        <Grid Grid.Row="2" Margin="4,2,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0"
                                       Style="{StaticResource IconButton}"
                                       Icon="{ui:SymbolIcon Attach24}"
                                       ToolTip="{DynamicResource S.Chat.Attach.ToolTip}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,2,0"
                                       Command="{Binding AttachFilesCommand}" />

                            <!--
                                Agent mode, and which kind of run, in one button. Both are one question -
                                what pressing Send does with this message - so they are one control, and it
                                is in the composer rather than in Settings because the answer changes from
                                message to message: plan, read the plan, then build.

                                A plain button rather than a toggle: every state here is chosen from the
                                menu, including off, so a click can never change what Send does by itself.
                                The caption carries the answer, because a control whose menu is shut has to
                                say what it is set to.
                            -->
                            <ui:Button Grid.Column="1"
                                       Content="{Binding AgentButtonText}"
                                       FontSize="12"
                                       Padding="9,4"
                                       CornerRadius="{StaticResource ChipCorner}"
                                       MinWidth="0"
                                       MinHeight="0"
                                       VerticalAlignment="Center"
                                       ToolTip="{DynamicResource S.Agent.ToolTip}"
                                       Click="OnAgentButtonClick">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <!-- Accented while it is on, which is the one state worth seeing from across the room. -->
                                            <DataTrigger Binding="{Binding IsAgentMode}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>

                                <ui:Button.ContextMenu>
                                    <!--
                                        Ordered by how much each mode changes, planning first, for the same
                                        reason the tool registry orders tools by risk: the first plausible
                                        entry is the one that gets picked.

                                        Each entry says what it costs on a second line rather than in a
                                        tooltip, because the difference between these four is the whole of
                                        the decision and nobody hovers a menu they are already reading.

                                        IsChecked is bound to one string rather than to three comparisons of
                                        the mode, so exactly one item can ever be marked - including Off,
                                        which is a state of this control as much as the other three are. It
                                        is one-way, and IsCheckable is left false: a click that set its own
                                        check would overwrite the binding for good.
                                    -->
                                    <ContextMenu>
                                        <MenuItem Command="{Binding SetAgentModeCommand}"
                                                  CommandParameter="{x:Static dto:AgentMode.Plan}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=Plan}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Agent.Mode.Plan}" />
                                                    <TextBlock Text="{DynamicResource S.Agent.Menu.Plan.Hint}"
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>

                                        <MenuItem Command="{Binding SetAgentModeCommand}"
                                                  CommandParameter="{x:Static dto:AgentMode.PlanCanvas}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=PlanCanvas}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Agent.Mode.PlanCanvas}" />
                                                    <TextBlock Text="{DynamicResource S.Agent.Menu.PlanCanvas.Hint}"
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>

                                        <MenuItem Command="{Binding SetAgentModeCommand}"
                                                  CommandParameter="{x:Static dto:AgentMode.Build}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=Build}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Agent.Mode.Build}" />
                                                    <TextBlock Text="{DynamicResource S.Agent.Menu.Build.Hint}"
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>

                                        <Separator />

                                        <MenuItem Command="{Binding TurnAgentOffCommand}"
                                                  IsChecked="{Binding AgentModeSelection, Mode=OneWay, Converter={StaticResource Equality}, ConverterParameter=Off}">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Agent.Mode.Off}" />
                                                    <TextBlock Text="{DynamicResource S.Agent.Menu.Off.Hint}"
                                                               Style="{StaticResource SubtleText}" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>

                            <!--
                                Dictation. One control for both ends of the session, the way Send and
                                Stop are one: a microphone while the machine is idle, a recording mark
                                while it is listening, and the words arrive in the box as they are
                                heard. Hidden entirely where Windows has no recognizer to drive.
                            -->
                            <ui:Button Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Margin="0,0,2,0"
                                       ToolTip="{Binding VoiceToolTip}"
                                       Command="{Binding ToggleVoiceInputCommand}"
                                       Visibility="{Binding IsSpeechAvailable, Converter={StaticResource BoolToVisibility}}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Mic24}" />
                                        <Style.Triggers>
                                            <!-- The one state worth seeing from across the room: the machine is listening. -->
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Icon" Value="{ui:SymbolIcon Record24}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <!-- Send and Stop swap: only one is ever meaningful. -->
                            <ui:Button Grid.Column="4"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Send24}"
                                       Width="34"
                                       Height="34"
                                       Padding="0"
                                       CornerRadius="17"
                                       ToolTip="{DynamicResource S.Chat.Send.ToolTip}"
                                       VerticalAlignment="Center"
                                       Command="{Binding SendCommand}"
                                       Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ui:Button Grid.Column="4"
                                       Appearance="Danger"
                                       Icon="{ui:SymbolIcon Stop24}"
                                       Width="34"
                                       Height="34"
                                       Padding="0"
                                       CornerRadius="17"
                                       ToolTip="{DynamicResource S.Settings.Shortcut.Stop}"
                                       VerticalAlignment="Center"
                                       Command="{Binding StopCommand}"
                                       Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!--
                    The line under the composer: what Enter does, what the microphone is doing,
                    and what the next message will do in agent mode - the three sentences that
                    stop a surprise send.
                -->
                <Grid Grid.Row="2" Margin="8,6,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding InputHint}"
                               Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- What the microphone is doing replaces what Enter does, for as long as it is doing it. -->
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               Text="{DynamicResource S.Chat.Voice.Listening}"
                               Foreground="{DynamicResource ApprovalAccentBrush}"
                               Margin="0,0,12,0"
                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />

                    <!-- What the next message will do, and where, while it is still possible not to send. -->
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource MutedText}"
                               Text="{Binding AgentHint}"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource ApprovalAccentBrush}"
                               Visibility="{Binding IsAgentMode, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
