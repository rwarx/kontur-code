<UserControl x:Class="AIClient.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             xmlns:md="clr-namespace:AIClient.App.Markdown"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>

        <!--
            One line of a diff. Shared by the approval card and the tool-call cards, and defined before
            both of them: a StaticResource cannot look forward.

            A Border per line rather than a coloured run, because the tint has to reach the full width
            of the card - a green patch that stops at the end of the text makes a short added line look
            like a partial change.
        -->
        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type vm:DiffLine}">
            <Border Padding="6,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{StaticResource DiffAddedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="Background" Value="{StaticResource DiffRemovedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!--
                    Never wrapped. The first character of a diff line is what it means, so a line
                    folded onto a second row would show text with no marker in front of it.
                -->
                <TextBlock Text="{Binding Text}"
                           FontFamily="{StaticResource CodeFont}"
                           FontSize="12"
                           TextWrapping="NoWrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Notice">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!--
            One tool call, under the step that asked for it.

            The header is always there, in every state, and the result is behind a chevron that only
            appears when there is a result to show. An Expander would have been less code, but it
            offers an arrow on a card with nothing under it, and greying that arrow out greys the
            headline with it - the one line the card exists to show.
        -->
        <DataTemplate x:Key="ToolCallTemplate" DataType="{x:Type vm:AgentToolCallViewModel}">
            <Border Margin="0,4,0,0"
                    Padding="8,6"
                    CornerRadius="{StaticResource CardCorner}"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The tool's own name, which the summary usually replaces in the headline. -->
                        <Border Grid.Column="0" Style="{StaticResource Badge}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ToolName}"
                                       Style="{StaticResource BadgeText}"
                                       FontFamily="{StaticResource CodeFont}" />
                        </Border>

                        <!--
                            Marks the calls that did something rather than looked at something, so a
                            long run can be scanned for the ones that matter. Absent for a read, and
                            absent for a restored card, which no longer knows.
                        -->
                        <Border Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Risk}" Value="Write">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Risk}" Value="Execute">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                        <Setter Property="Foreground" Value="{StaticResource ApprovalAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Risk}" Value="Write">
                                                <Setter Property="Text" Value="changed files" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="Execute">
                                                <Setter Property="Text" Value="ran a program" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!--
                            Trimmed, never wrapped. A summary is one line by construction, and a card
                            that grows a second row as its text arrives makes the transcript jump
                            under whatever the user was reading.
                        -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Headline}"
                                   Margin="8,0,8,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Headline}" />

                        <TextBlock Grid.Column="3" Text="{Binding StateText}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Proposed">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource ApprovalAccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Denied">
                                            <Setter Property="Foreground" Value="{StaticResource ApprovalAccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Abandoned">
                                            <Setter Property="Foreground" Value="{StaticResource ApprovalAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ToggleButton Grid.Column="4"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="4,0"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Margin="4,0,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip="Show what this returned">
                            <ui:SymbolIcon FontSize="14">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ChevronDown24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Symbol" Value="ChevronUp24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ToggleButton>
                    </Grid>

                    <!--
                        The result, in one of its two forms. Which one was decided when the body was
                        set, because deciding it here would mean the template guessing at whether a
                        line beginning with a hyphen is a deletion or a bullet.

                        A darker well than the card so the two do not merge, and both forms are
                        capped and scrollable: a diff arrives capped by TextDiff, but a file the
                        agent read arrives however long the file is.
                    -->
                    <Border Margin="0,8,0,0"
                            CornerRadius="6"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <ScrollViewer MaxHeight="220"
                                          Padding="4,6"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsBodyDiff, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding BodyLines}"
                                              ItemTemplate="{StaticResource DiffLineTemplate}"
                                              Focusable="False" />
                            </ScrollViewer>

                            <!--
                                A TextBox rather than a TextBlock: a tool result is the sort of thing
                                a user wants to copy out - a path, an error, a line of a file - and
                                selection is what makes that possible.
                            -->
                            <TextBox Text="{Binding Body, Mode=OneWay}"
                                     IsReadOnly="True"
                                     MaxHeight="220"
                                     Padding="4,6"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="12"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Visibility="{Binding IsBodyText, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One message. Role decides the shape, status decides the extras. -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageViewModel}">
            <Grid Margin="0,0,0,20" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Attachment chips, above the text they were sent with. -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Attachments}"
                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="{Binding IsUser, Converter={StaticResource UserAlignment}}"
                              Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AttachmentChip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    User message. Shown verbatim in a right-aligned bubble: rendering the
                    user's own markdown would mangle a pasted snippet they are asking about.
                -->
                <Border Grid.Row="1"
                        Style="{StaticResource UserMessageCard}"
                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Inline edit (section 20). -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                    MinWidth="420">
                            <ui:TextBox Text="{Binding EditDraft, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MaxHeight="260"
                                        VerticalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0">
                                <ui:Button Content="Cancel"
                                           Margin="0,0,6,0"
                                           Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Content="Save &amp; resend"
                                           Appearance="Primary"
                                           Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Assistant message: model label, then the rendered blocks. -->
                <StackPanel Grid.Row="2"
                            Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Style="{StaticResource SubtleText}"
                               Text="{Binding ModelId}"
                               Margin="0,0,0,6"
                               Visibility="{Binding ModelId, Converter={StaticResource StringToVisibility}}" />

                    <!-- Thinking state: something is on screen before the first token lands. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,6"
                                Visibility="{Binding IsAwaitingFirstToken, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Thinking…" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!--
                        What the model said it was thinking, when the provider sends it. Above the
                        answer because that is the order it happened in, and collapsed because it is
                        working out rather than an answer - and it is not what the model will be shown
                        of its own turn on the next step.
                    -->
                    <Expander Margin="0,0,0,8"
                              IsExpanded="{Binding IsReasoningExpanded, Mode=TwoWay}"
                              Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVisibility}}">
                        <Expander.Header>
                            <TextBlock Text="Reasoning" FontSize="12" />
                        </Expander.Header>

                        <TextBox Text="{Binding Reasoning, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="220"
                                 Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Expander>

                    <!--
                        Rendered markdown. Blocks are reconciled by content hash during
                        streaming, so this ItemsControl only rebuilds the tail.
                    -->
                    <ItemsControl ItemsSource="{Binding Blocks}"
                                  Focusable="False"
                                  Visibility="{Binding IsRenderingMarkdown, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Markdown rendering off: raw text, still selectable. -->
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsRenderingMarkdown, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!--
                        The tools this step asked for, under the text that asked for them. Not
                        virtualised: a step is capped at a handful of calls, and each card lays out
                        its result only once expanded.
                    -->
                    <ItemsControl ItemsSource="{Binding ToolCalls}"
                                  ItemTemplate="{StaticResource ToolCallTemplate}"
                                  Focusable="False"
                                  Margin="0,6,0,0"
                                  Visibility="{Binding HasToolCalls, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Error state with a separate technical section and Retry (section 21). -->
                <ui:InfoBar Grid.Row="3"
                            Severity="Error"
                            IsOpen="{Binding HasFailed, Mode=OneWay}"
                            IsClosable="False"
                            Title="Request failed"
                            Message="{Binding ErrorMessage}"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,8,0,0">
                        <Expander Header="Technical details"
                                  Visibility="{Binding ErrorTechnicalDetails, Converter={StaticResource StringToVisibility}}">
                            <TextBox Text="{Binding ErrorTechnicalDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0" />
                        </Expander>

                        <ui:Button Content="Retry"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   HorizontalAlignment="Left"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsRetryable, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </ui:InfoBar>

                <TextBlock Grid.Row="3"
                           Style="{StaticResource SubtleText}"
                           Text="Generation stopped."
                           Margin="0,6,0,0"
                           Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVisibility}}" />

                <!--
                    Action bar. Visible on hover or while the row is focused, so a scrolled
                    transcript is not a wall of buttons.
                -->
                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                    <Setter Property="Opacity" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Assistant: Copy, Regenerate. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="Copy"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   ToolTip="Copy message"
                                   Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="Regenerate"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   ToolTip="Generate a new answer"
                                   Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   ToolTip="Delete message"
                                   Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />

                        <TextBlock Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource UsageSummary}">
                                    <Binding Path="InputTokens" />
                                    <Binding Path="OutputTokens" />
                                    <Binding Path="GenerationTimeMs" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <!-- User: Edit, Delete. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="Edit"
                                   Icon="{ui:SymbolIcon Edit24}"
                                   Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Content="Copy"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource MessageActionButton}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   ToolTip="Delete message"
                                   Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid md:MarkdownHost.HighlightCode="{Binding HighlightCode}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Transcript -->
        <ScrollViewer x:Name="TranscriptScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,16,0,8"
                      ScrollChanged="OnTranscriptScrollChanged">
            <Grid MaxWidth="{StaticResource ContentMaxWidth}" Margin="24,0">
                <!--
                    VirtualizingStackPanel: a long conversation is hundreds of message
                    subtrees, and realising all of them is exactly the "thousands of heavy UI
                    elements" section 27 warns about. Recycling keeps scrolling smooth.
                -->
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplate="{StaticResource MessageTemplate}"
                              Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty state (section 33): never a blank grey panel. -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,40"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="What can I help you with?"
                               FontSize="26"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Ask a question, paste some code, or attach a file."
                               Style="{StaticResource SubtleText}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28" />

                    <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="640" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Margin="4"
                                           Padding="14,10"
                                           MinWidth="200"
                                           HorizontalContentAlignment="Left"
                                           Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource SubtleText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Jump-to-bottom, shown once the user has scrolled away from the tail. -->
        <ui:Button Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,12"
                   Padding="10,6"
                   Icon="{ui:SymbolIcon ArrowDown24}"
                   Content="Jump to latest"
                   Click="OnJumpToLatest"
                   Visibility="{Binding IsScrolledAway, Converter={StaticResource BoolToVisibility}}" />

        <!--
            The approval gate (section 28). Docked above the composer rather than raised as a modal
            dialog, because the answer depends on the transcript behind it - which file the model said
            it was editing, what it claimed to have read - and a window centred over that text would
            hide the evidence the user needs.
        -->
        <Border Grid.Row="1"
                Margin="24,0,24,0"
                Padding="14,12"
                CornerRadius="{StaticResource CardCorner}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderThickness="3,1,1,1"
                BorderBrush="{StaticResource ApprovalAccentBrush}"
                MaxWidth="{StaticResource ContentMaxWidth}"
                Visibility="{Binding Approval.IsAsking, Converter={StaticResource BoolToVisibility}}">

            <!--
                Bound to the pending question rather than to the chat pane. When there is no question
                the card is collapsed, so the null DataContext underneath is never rendered.
            -->
            <Grid DataContext="{Binding Approval.Pending}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- What is being asked, and what it costs if the answer is yes. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Warning24"
                                   FontSize="18"
                                   Margin="0,1,10,0"
                                   VerticalAlignment="Top"
                                   Foreground="{StaticResource ApprovalAccentBrush}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Headline}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Consequence}"
                                   Style="{StaticResource SubtleText}"
                                   TextTrimming="None"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />

                        <!--
                            Shown when the same call is asked about twice in one run. Without it the
                            user is left wondering whether they misread the previous question.
                        -->
                        <TextBlock Text="You already allowed this exact call in this run. It is being asked again because answers to this kind of call are deliberately not remembered."
                                   Style="{StaticResource SubtleText}"
                                   TextTrimming="None"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsRepeat, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ToolName}" Style="{StaticResource BadgeText}" />
                    </Border>
                </Grid>

                <!--
                    The diff. Not virtualised on purpose: TextDiff caps a preview at four hundred
                    lines, so the worst case is a few hundred short TextBlocks, and the panel a
                    ScrollViewer would need to virtualise costs more than it saves at that size.
                -->
                <Border Grid.Row="1"
                        Style="{StaticResource CodeBlockContainer}"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer MaxHeight="240"
                                  Padding="4,6"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PreviewLines}"
                                      ItemTemplate="{StaticResource DiffLineTemplate}"
                                      Focusable="False" />
                    </ScrollViewer>
                </Border>

                <!--
                    The raw call, collapsed. Rarely the thing the decision turns on, and the one place
                    to look when the summary and the diff disagree with each other.
                -->
                <Expander Grid.Row="2"
                          Margin="0,8,0,0"
                          IsExpanded="{Binding IsArgumentsExpanded, Mode=TwoWay}"
                          Visibility="{Binding HasArguments, Converter={StaticResource BoolToVisibility}}">
                    <Expander.Header>
                        <TextBlock Text="Arguments" FontSize="12" />
                    </Expander.Header>

                    <TextBox Text="{Binding ArgumentsJson, Mode=OneWay}"
                             IsReadOnly="True"
                             MaxHeight="140"
                             Margin="0,6,0,0"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Expander>

                <!--
                    The answer. The reason sits next to Don't allow because that is the only button it
                    changes: it is sent to the model in place of the loop's plain refusal, and turns
                    "no" into a correction the model can act on in one step.
                -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                Text="{Binding DenyReason, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Why not? Optional, and sent to the model."
                                Margin="0,0,10,0"
                                VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Don't allow"
                                   Appearance="Secondary"
                                   Padding="12,7"
                                   Margin="0,0,6,0"
                                   Command="{Binding DenyCommand}" />

                        <ui:Button Content="Allow for this run"
                                   Appearance="Secondary"
                                   Padding="12,7"
                                   Margin="0,0,6,0"
                                   Command="{Binding AllowForRunCommand}"
                                   Visibility="{Binding CanAllowForRun, Converter={StaticResource BoolToVisibility}}" />

                        <ui:Button Content="Allow once"
                                   Appearance="Primary"
                                   Padding="12,7"
                                   Command="{Binding AllowCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Composer -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Padding="24,12,24,16">
            <Grid MaxWidth="{StaticResource ContentMaxWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Transient notice: attachment rejected, export written, model not chosen. -->
                <ui:InfoBar Grid.Row="0"
                            Severity="Warning"
                            IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                            Message="{Binding BannerMessage}"
                            Margin="0,0,0,8" />

                <!-- Staged attachments as removable chips (section 19). -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding PendingAttachments}"
                              Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AttachmentChip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Text="{Binding DisplaySize}"
                                               Style="{StaticResource SubtleText}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="truncated"
                                               Style="{StaticResource SubtleText}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontStyle="Italic"
                                               Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="✕"
                                            Margin="8,0,0,0"
                                            Padding="4,0"
                                            FontSize="11"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTip="Remove attachment"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Input row -->
                <Border Grid.Row="2"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Padding="6"
                        AllowDrop="True"
                        Drop="OnFilesDropped"
                        DragOver="OnFilesDragOver">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0"
                                   Icon="{ui:SymbolIcon Attach24}"
                                   ToolTip="Attach a file"
                                   Appearance="Secondary"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,4,0"
                                   Command="{Binding AttachFilesCommand}" />

                        <!--
                            Agent mode. A toggle in the composer rather than a setting, because it
                            changes what pressing Send does: the model gets to read and change files
                            under the folder that is open, asking first for anything it cannot undo.
                        -->
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsAgentMode, Mode=TwoWay}"
                                      Content="Agent"
                                      FontSize="12"
                                      Padding="10,4"
                                      MinWidth="0"
                                      MinHeight="0"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,4,4"
                                      ToolTip="Let the model work on the project. It plans by default, and asks before anything it cannot take back." />

                        <!--
                            Which kind of run, and next to the toggle for the same reason the toggle is
                            in the composer: it decides what Send does, and it is a per-message choice -
                            plan, look at the plan, then build - rather than a preference. Hidden while
                            agent mode is off, where it would be three options that do nothing.
                        -->
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding AgentModes}"
                                  SelectedValuePath="Mode"
                                  SelectedValue="{Binding SelectedAgentMode, Mode=TwoWay}"
                                  FontSize="12"
                                  MinWidth="128"
                                  MinHeight="0"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,4,4"
                                  Visibility="{Binding IsAgentMode, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox x:Name="DraftBox"
                                 Grid.Column="3"
                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinLines="1"
                                 MaxLines="12"
                                 MaxHeight="240"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="4,8"
                                 PreviewKeyDown="OnDraftKeyDown"
                                 SpellCheck.IsEnabled="True" />

                        <!-- Send and Stop swap: only one is ever meaningful. -->
                        <ui:Button Grid.Column="4"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Send24}"
                                   ToolTip="Send (Enter)"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,0"
                                   Command="{Binding SendCommand}"
                                   Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVisibility}}" />

                        <ui:Button Grid.Column="4"
                                   Appearance="Danger"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   ToolTip="Stop generating (Esc)"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,0"
                                   Command="{Binding StopCommand}"
                                   Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="4,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource SubtleText}"
                               Text="{Binding InputHint}" />

                    <!-- What the next message will do, and where, while it is still possible not to send. -->
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource SubtleText}"
                               Text="{Binding AgentHint}"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource ApprovalAccentBrush}"
                               Visibility="{Binding IsAgentMode, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
