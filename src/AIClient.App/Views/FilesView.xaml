<UserControl x:Class="AIClient.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kontur="clr-namespace:AIClient.App.Controls"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilesViewModel}"
             Background="{DynamicResource Brush.Surface0}"
             TextElement.Foreground="{DynamicResource Brush.TextPrimary}">

    <!--
        The file tree. One column of rows, one lazy listing per folder, and a details
        panel beside it when something is selected - the density of a file browser
        rather than the ceremony of a file manager.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- The tree. -->
        <Grid Grid.Column="0" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource Brush.Surface1}" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <kontur:KonturIcon Grid.Column="0" Kind="Files" Width="14" Height="14"
                                       Foreground="{DynamicResource Brush.AccentText}" />
                    <TextBlock Grid.Column="1" Text="{Binding RootName, FallbackValue='Files'}"
                               Style="{StaticResource Type.Section}" Margin="9,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource KcButtonTool}" Width="24" Height="24"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh">
                        <kontur:KonturIcon Kind="Refresh" Width="13" Height="13" />
                    </Button>
                </Grid>
            </Border>

            <TreeView x:Name="Tree" Grid.Row="1"
                      ItemsSource="{Binding Root}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="6,4"
                      VirtualizingPanel.IsVirtualizing="True"
                      SelectedItemChanged="OnSelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="Row" Background="Transparent"
                                                CornerRadius="{StaticResource Radius.SM}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
                                        </Border>
                                        <!-- Children only exist for loaded folders, which is what
                                             keeps a deep repository from laying out itself eagerly. -->
                                        <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource Brush.SurfaceHover}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Brush.TextPrimary}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource Brush.SurfaceSelected}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Brush.AccentText}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" MinHeight="24">
                            <kontur:KonturIcon Kind="{Binding Kind}" Width="14" Height="14" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Type.Caption}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <kontur:KonturIcon Kind="Refresh" Width="10" Height="10" GlyphThickness="2.2"
                                               Foreground="{DynamicResource Brush.AccentText}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Column="1" Style="{StaticResource KcSplitV}" />

        <!-- Details. -->
        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface0}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Background="{DynamicResource Brush.Surface1}" Padding="14,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <kontur:KonturIcon Kind="{Binding SelectedEntry.Kind, TargetNullValue=File}"
                                               Width="16" Height="16"
                                               Foreground="{DynamicResource Brush.AccentText}" />
                            <TextBlock Text="{Binding SelectedEntry.Name, TargetNullValue='—'}"
                                       Style="{StaticResource Type.Section}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedEntry.Path, TargetNullValue=''}"
                                   Style="{StaticResource Type.Metadata}" Margin="26,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="14,12">
                    <!-- Selected file: open it; selected folder: expand it. -->
                    <StackPanel VerticalAlignment="Top"
                                Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibility}}">
                        <Button Style="{StaticResource KcButtonPrimary}" Padding="14,8" MinWidth="140"
                                Command="{Binding SelectedEntry.OpenCommand}"
                                Visibility="{Binding SelectedEntry.IsDirectory, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Open" Width="13" Height="13"
                                                   Foreground="{DynamicResource Brush.TextOnAccent}" />
                                <TextBlock Text="Open in Code" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Type.Caption}" Margin="2,12,0,0"
                                   Text="{Binding SelectedEntry.DisplaySize, TargetNullValue=''}" />
                    </StackPanel>

                    <!-- Nothing selected: the honest empty state. -->
                    <TextBlock Style="{StaticResource Type.Caption}" Opacity="0.6"
                               Text="Select a file to see it here."
                               Visibility="{Binding SelectedEntry, Converter={StaticResource InverseNullToVisibility}}"
                               VerticalAlignment="Top" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
