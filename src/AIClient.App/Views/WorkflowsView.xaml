<UserControl x:Class="AIClient.App.Views.WorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kontur="clr-namespace:AIClient.App.Controls"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WorkflowsViewModel}"
             Background="{DynamicResource Brush.Surface0}"
             TextElement.Foreground="{DynamicResource Brush.TextPrimary}">

    <!--
        The automation hub: runnable recipe presets up top, the live tool catalogue
        below. A recipe stages its prompt in the composer - it never sends on its own.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
        <StackPanel MaxWidth="860">
            <StackPanel Orientation="Horizontal">
                <kontur:KonturIcon Kind="Sparkle" Width="14" Height="14"
                                   Foreground="{DynamicResource Brush.AccentText}" />
                <TextBlock Text="{DynamicResource S.Mode.Title.Workflows}" Style="{StaticResource Type.Section}"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Type.Caption}" Margin="0,6,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{DynamicResource S.Workflows.Subtitle}" />

            <!-- Recipes. -->
            <TextBlock Text="{DynamicResource S.Workflows.Recipes.Title}" Style="{StaticResource Type.Caption}"
                       FontWeight="SemiBold" Margin="0,14,0,6" />
            <ItemsControl ItemsSource="{Binding Recipes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface1}"
                                BorderBrush="{DynamicResource Brush.BorderFaint}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" MinWidth="0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Type.Caption}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Type.Metadata}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource Type.Metadata}" Opacity="0.7" Margin="0,5,0,0">
                                        <Run Text="{Binding ModeName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource KcButtonPrimary}"
                                        Padding="12,5" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RunRecipeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <kontur:KonturIcon Kind="Play" Width="12" Height="12" />
                                        <TextBlock Text="{DynamicResource S.Workflows.Run}" Style="{StaticResource Type.Caption}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Tool catalogue: what the agent can actually call, from the live registry. -->
            <TextBlock Text="{DynamicResource S.Workflows.Tools.Title}" Style="{StaticResource Type.Caption}"
                       FontWeight="SemiBold" Margin="0,10,0,2" />
            <TextBlock Style="{StaticResource Type.Metadata}" Margin="0,0,0,6"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{DynamicResource S.Workflows.Tools.Hint}" />
            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceSunken}"
                                    BorderBrush="{DynamicResource Brush.BorderFaint}" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource Size.Metadata}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Type.Metadata}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Risk}" Style="{StaticResource Type.Metadata}"
                                       Opacity="0.7" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
