<UserControl x:Class="AIClient.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AIClient.App.Views"
             xmlns:kontur="clr-namespace:AIClient.App.Controls"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModelsPageViewModel}"
             Background="{DynamicResource Brush.Surface0}"
             TextElement.Foreground="{DynamicResource Brush.TextPrimary}">

    <!--
        The models surface: providers as compact rows (state, key, catalogue size), the
        catalogue itself through the picker's own collection. One catalogue, one
        selection, two entrances - this page and the top-bar chip.
    -->
    <Grid MaxWidth="860" Margin="0,0,0,0" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Brush.Surface1}" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <kontur:KonturIcon Kind="Models" Width="14" Height="14"
                                   Foreground="{DynamicResource Brush.AccentText}" />
                <TextBlock Text="Models" Style="{StaticResource Type.Section}" Margin="9,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Providers.Count, StringFormat={}{0} providers}"
                           Style="{StaticResource Type.Metadata}" Margin="12,0,0,0" Opacity="0.6"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Providers: one row each, dense and glanceable. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Providers}" Margin="10,8,10,6">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface1}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.MD}" Padding="12,8" Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <kontur:KonturIcon Grid.Column="0" Kind="{Binding Icon}" Width="14" Height="14"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Type.Caption}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KeyLabel}" Style="{StaticResource Type.Metadata}"
                                           Opacity="0.7" />
                            </StackPanel>

                            <!-- Connection state: the dot carries it. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="MissingKey">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Testing">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Running}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Updating">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Running}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding CatalogueLabel}" Style="{StaticResource Type.Metadata}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="3" Style="{StaticResource KcButtonGhost}" Padding="9,4" Margin="0,0,4,0"
                                    Command="{Binding DataContext.RefreshProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="Fetch the catalogue from the provider">
                                <StackPanel Orientation="Horizontal">
                                    <kontur:KonturIcon Kind="Refresh" Width="12" Height="12" />
                                    <TextBlock Text="Refresh" Style="{StaticResource Type.Metadata}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4" Style="{StaticResource KcButtonGhost}" Padding="9,4"
                                    Command="{Binding DataContext.TestProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="Test the connection">
                                <StackPanel Orientation="Horizontal">
                                    <kontur:KonturIcon Kind="Check" Width="12" Height="12" />
                                    <TextBlock Text="Test" Style="{StaticResource Type.Metadata}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The catalogue: the picker's own view, reused so selection is literally the same act. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Surface0}" Margin="10,4,10,10"
                CornerRadius="{StaticResource Radius.MD}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.BorderFaint}"
                        BorderThickness="0,0,0,1" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Catalogue" Style="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Click a model to make it the default for new chats"
                                   Style="{StaticResource Type.Metadata}" Margin="10,0,0,0" Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <views:ModelPickerView Grid.Row="1" DataContext="{Binding Picker}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
