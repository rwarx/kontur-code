<UserControl x:Class="AIClient.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:AIClient.App.Behaviors"
             xmlns:kontur="clr-namespace:AIClient.App.Controls"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="800" d:DesignWidth="820"
             Background="{DynamicResource Brush.Surface0}"
             TextElement.Foreground="{DynamicResource Brush.TextPrimary}">

    <UserControl.Resources>
        <!-- A labelled row: description on the left, control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <!-- The section heading inside the page body. -->
        <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource Type.Title}">
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>

        <!-- Numeric entry: invariant text, committed on blur, never a spinner strip. -->
        <Style x:Key="NumericInput" TargetType="TextBox" BasedOn="{StaticResource KcInputPlaceholder}">
            <Setter Property="Width" Value="150" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: what this page is, and the way back. -->
        <Grid Grid.Row="0" Margin="24,14,24,4">
            <StackPanel Orientation="Horizontal">
                <kontur:KonturIcon Kind="Settings" Width="16" Height="16"
                                   Foreground="{DynamicResource Brush.AccentText}"
                                   VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource S.Settings.Title}" Style="{StaticResource Type.Title}" FontSize="19" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Style="{StaticResource KcButtonTool}" HorizontalAlignment="Right"
                    ToolTip="{DynamicResource S.Settings.Back.WorkspaceTip}"
                    Command="{Binding DataContext.ShowChatCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <kontur:KonturIcon Kind="Close" Width="13" Height="13" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,0,24,24">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!--
                    Providers first. Every other setting on this page is inert until a key
                    exists, and this is the screen the first-run wizard sends people to.
                -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.Providers}" Margin="0,10,0,10" />

                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KcCard}" Margin="0,0,0,10" Padding="14,12">
                                <StackPanel>

                                    <!-- Header: status dot, name, status line, enable switch -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- In-memory state only. A green dot restored from
                                             last week's launch would vouch for a key that may
                                             since have been revoked. -->
                                        <Ellipse Grid.Column="0"
                                                 Width="9" Height="9"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Failed">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Testing">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Running}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Type.Body}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Type.Metadata}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource S.Provider.Enabled}" Style="{StaticResource Type.Metadata}"
                                                       Margin="0,0,8,0" Opacity="0.7" />
                                            <CheckBox IsChecked="{Binding IsEnabled}"
                                                      ToolTip="{DynamicResource S.Provider.Include.ToolTip}" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Margin="0,10" />

                                    <!-- Stored key: a fixed mask, never the value itself.
                                         Section 11 - there is no code path from secure storage
                                         back to this screen. -->
                                    <Grid Visibility="{Binding IsEditingApiKey, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource S.Provider.ApiKey}" Style="{StaticResource Type.Metadata}"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                            <TextBlock Text="{Binding ApiKeyDisplay}"
                                                       FontFamily="{StaticResource CodeFont}"
                                                       FontSize="{StaticResource Size.Caption}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Provider.Change}"
                                                    Padding="10,4" Margin="0,0,6,0"
                                                    Command="{Binding BeginEditApiKeyCommand}"
                                                    Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource KcButtonPrimary}" Content="{DynamicResource S.Provider.AddKey}"
                                                    Padding="10,4" Margin="0,0,6,0"
                                                    Command="{Binding BeginEditApiKeyCommand}"
                                                    Visibility="{Binding HasApiKey, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Button Style="{StaticResource KcButtonDanger}" Content="{DynamicResource S.Provider.Remove}"
                                                    Padding="10,4"
                                                    Command="{Binding RemoveApiKeyCommand}"
                                                    Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Entry. A PasswordBox, so the key is not a bound
                                         property and not readable out of the visual tree. -->
                                    <StackPanel Visibility="{Binding IsEditingApiKey, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource S.Provider.ApiKey}" Style="{StaticResource Type.Metadata}"
                                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,5" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <PasswordBox Grid.Column="0"
                                                         beh:ApiKeyBox.Attach="True"
                                                         VerticalContentAlignment="Center"
                                                         Padding="8,6" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Style="{StaticResource KcButtonPrimary}" Content="{DynamicResource S.Common.Save}"
                                                        Padding="10,4" Margin="0,0,6,0"
                                                        Command="{Binding SaveApiKeyCommand}" />
                                                <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Common.Cancel}"
                                                        Padding="10,4"
                                                        Command="{Binding CancelEditApiKeyCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource Type.Metadata}"
                                                   Margin="0,7,0,0"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   Text="{DynamicResource S.Provider.KeyNote}" />
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Provider.TestConnection}"
                                                Padding="10,4" Margin="0,0,6,0"
                                                Command="{Binding TestConnectionCommand}" />
                                        <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Provider.RefreshModels}"
                                                Padding="10,4" Margin="0,0,6,0"
                                                Command="{Binding RefreshModelsCommand}" />
                                        <Button Style="{StaticResource KcLink}" Content="{DynamicResource S.Provider.GetKey}"
                                                VerticalAlignment="Center"
                                                Command="{Binding OpenApiKeyPageCommand}"
                                                Visibility="{Binding ApiKeyUrl, Converter={StaticResource StringToVisibility}}" />

                                        <kontur:KonturIcon Kind="Refresh" Width="14" Height="14"
                                                           Foreground="{DynamicResource Brush.AccentText}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- A user-defined provider can be removed; a built-in one
                                         can only be disabled. Same row, different futures. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource KcButtonDanger}" Content="{DynamicResource S.Settings.Providers.Remove}"
                                                Padding="10,4"
                                                Command="{Binding DataContext.RemoveProviderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Type.Metadata}"
                                               Margin="0,9,0,0"
                                               Text="{Binding ModelSummary}" />

                                    <!-- Section 21: the human sentence is the status line
                                         above; the raw detail is here, folded away. -->
                                    <Expander Margin="0,8,0,0"
                                              Visibility="{Binding TechnicalDetails, Converter={StaticResource StringToVisibility}}">
                                        <Expander.Header>
                                            <TextBlock Text="{DynamicResource S.Common.TechnicalDetails}" Style="{StaticResource Type.Metadata}"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                        </Expander.Header>
                                        <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 MaxHeight="160"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource KcInputBare}"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 FontSize="12" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Custom providers: any OpenAI-compatible endpoint the user names. -->
                <Border Style="{StaticResource KcCard}" Margin="0,4,0,10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Settings.Providers.AddCustom}" Style="{StaticResource Type.Body}"
                                   FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Type.CaptionWrap}" Margin="0,3,0,10"
                                   Text="{DynamicResource S.Settings.Providers.AddCustom.Hint}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource KcInputPlaceholder}"
                                     Tag="{DynamicResource S.Settings.Providers.NamePlaceholder}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,6,0"
                                     Text="{Binding NewProviderName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource KcInputPlaceholder}"
                                     Tag="{DynamicResource S.Settings.Providers.UrlPlaceholder}"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,6,0"
                                     Text="{Binding NewProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource KcButtonPrimary}"
                                    Content="{DynamicResource S.Settings.Providers.Add}"
                                    Padding="12,4"
                                    Command="{Binding AddCustomProviderCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Text="{Binding NewProviderProblem}"
                                   Visibility="{Binding NewProviderProblem, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ============ General ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.General}" />

                <Border Style="{StaticResource KcCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.General.Language}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right"
                                      MinWidth="160"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="NativeName" />
                        </Grid>
                        <CheckBox Style="{StaticResource SettingCheck}"
                                  Content="{DynamicResource S.Settings.General.Reopen}"
                                  IsChecked="{Binding RestoreLastConversation}" />
                        <CheckBox Style="{StaticResource SettingCheck}"
                                  Content="{DynamicResource S.Settings.General.ConfirmDelete}"
                                  IsChecked="{Binding ConfirmBeforeDelete}" />
                        <CheckBox Content="{DynamicResource S.Settings.General.AutoTitles}"
                                  IsChecked="{Binding AutoGenerateTitles}" />
                    </StackPanel>
                </Border>

                <!-- ============ Appearance ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.Appearance}" />

                <Border Style="{StaticResource KcCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Appearance.Theme}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right"
                                      MinWidth="160"
                                      ItemsSource="{Binding ThemeModes}"
                                      SelectedItem="{Binding Theme}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Appearance.ChatFontSize}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider Width="180"
                                        Minimum="10" Maximum="24"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ChatFontSize}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChatFontSize, StringFormat={}{0:0}}"
                                           Style="{StaticResource Type.Metadata}"
                                           Width="28" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Appearance.CodeFontSize}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider Width="180"
                                        Minimum="9" Maximum="22"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding CodeFontSize}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CodeFontSize, StringFormat={}{0:0}}"
                                           Style="{StaticResource Type.Metadata}"
                                           Width="28" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="{DynamicResource S.Settings.Appearance.Mica}"
                                  IsChecked="{Binding UseMicaBackdrop}" />
                    </StackPanel>
                </Border>

                <!-- ============ Chat ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Mode.Chat}" />

                <Border Style="{StaticResource KcCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Settings.Chat.SystemPrompt}" Style="{StaticResource Type.Caption}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,0,0,14"
                                   Text="{DynamicResource S.Settings.Chat.SystemPrompt.Hint}" />

                        <!--
                            Each sampling parameter is a checkbox plus a value. Unchecked means
                            the field is left out of the request entirely (section 14) rather
                            than sent as a default: several models answer a parameter they do
                            not implement with a 400 instead of ignoring it.
                        -->
                        <Grid Style="{StaticResource SettingRow}">
                            <CheckBox Content="{DynamicResource S.Settings.Chat.Temperature}"
                                      IsChecked="{Binding IsTemperatureEnabled}"
                                      VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        IsEnabled="{Binding IsTemperatureEnabled}">
                                <Slider Width="180"
                                        Minimum="0" Maximum="2"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Temperature}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Temperature, StringFormat={}{0:0.0}}"
                                           Style="{StaticResource Type.Metadata}"
                                           Width="34" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <CheckBox Content="{DynamicResource S.Settings.Chat.TopP}"
                                      IsChecked="{Binding IsTopPEnabled}"
                                      VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        IsEnabled="{Binding IsTopPEnabled}">
                                <Slider Width="180"
                                        Minimum="0" Maximum="1"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding TopP}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TopP, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource Type.Metadata}"
                                           Width="34" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <CheckBox Content="{DynamicResource S.Settings.Chat.MaxTokens}"
                                      IsChecked="{Binding IsMaxTokensEnabled}"
                                      VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     IsEnabled="{Binding IsMaxTokensEnabled}"
                                     Text="{Binding MaxTokens, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Separator Margin="0,4,0,12" />

                        <CheckBox Style="{StaticResource SettingCheck}"
                                  Content="{DynamicResource S.Settings.Chat.SendWithEnter}"
                                  IsChecked="{Binding SendWithEnter}" />
                        <CheckBox Style="{StaticResource SettingCheck}"
                                  Content="{DynamicResource S.Settings.Chat.RenderMarkdown}"
                                  IsChecked="{Binding RenderMarkdown}" />
                        <CheckBox Style="{StaticResource SettingCheck}"
                                  Content="{DynamicResource S.Settings.Chat.HighlightCode}"
                                  IsChecked="{Binding HighlightCode}" />
                        <CheckBox Style="{StaticResource SettingCheck}"
                                  Content="{DynamicResource S.Settings.Chat.AutoScroll}"
                                  IsChecked="{Binding AutoScroll}" />
                        <CheckBox Content="{DynamicResource S.Settings.Chat.ShowUsage}"
                                  IsChecked="{Binding ShowTokenUsage}"
                                  Margin="0,0,0,14" />

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Chat.History}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding MaxHistoryMessages, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Chat.Timeout}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding RequestTimeoutSeconds, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Agent ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.Agent}" />

                <Border Style="{StaticResource KcCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Settings.Agent.Workspace}" Style="{StaticResource Type.Caption}" Margin="0,0,0,5" />

                        <!--
                            The whole of the agent's reach, in one line. Everything it can read,
                            change or delete is under this path; with no folder open it can do
                            nothing at all, which is the state the application starts in.
                        -->
                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   FontFamily="{StaticResource CodeFont}"
                                   Text="{Binding WorkspaceLabel}"
                                   Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Settings.Agent.Choose}" Padding="10,4"
                                    Command="{Binding ChooseWorkspaceCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Settings.Agent.ShowInExplorer}" Padding="10,4"
                                    Command="{Binding OpenWorkspaceFolderCommand}"
                                    Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource KcButtonDanger}" Content="{DynamicResource S.Settings.Agent.Close}" Padding="10,4"
                                    ToolTip="{DynamicResource S.Settings.Agent.Close.ToolTip}"
                                    Command="{Binding CloseWorkspaceCommand}"
                                    Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- The workspace's own words, because it refuses more folders than a picker does. -->
                        <Border Background="{DynamicResource Brush.WarningSoft}"
                                BorderBrush="{DynamicResource Brush.Warning}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="10,7"
                                Margin="0,0,0,10"
                                Visibility="{Binding WorkspaceProblem, Converter={StaticResource StringToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Warning" Width="13" Height="13"
                                                   Foreground="{DynamicResource Brush.Warning}"
                                                   VerticalAlignment="Top" Margin="0,1,9,0" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Settings.Agent.NotOpened}" Style="{StaticResource Type.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="{Binding WorkspaceProblem}" Style="{StaticResource Type.CaptionWrap}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,0,0,14"
                                   Text="{DynamicResource S.Settings.Agent.Hint}" />

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Agent.MaxSteps}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding MaxAgentSteps, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Agent.TimeLimit}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding MaxAgentSeconds, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Agent.MaxFile}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding MaxAgentFileKilobytes, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Running programs ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.Programs}" />

                <Border Style="{StaticResource KcCard}">
                    <StackPanel>
                        <!--
                            The one switch in this application that changes what kind of thing the agent
                            is, so the consequence is written next to it rather than in a tooltip. Off by
                            default, and only a person can move it.
                        -->
                        <CheckBox Content="{DynamicResource S.Settings.Programs.Allow}"
                                  IsChecked="{Binding AllowCommands}"
                                  Margin="0,0,0,6" />

                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,0,0,10"
                                   Text="{DynamicResource S.Settings.Programs.Allow.Hint}" />

                        <Border Background="{DynamicResource Brush.WarningSoft}"
                                BorderBrush="{DynamicResource Brush.Warning}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="10,7"
                                Margin="0,0,0,12"
                                Visibility="{Binding AllowCommands, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <kontur:KonturIcon Kind="Warning" Width="13" Height="13"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       VerticalAlignment="Top" Margin="0,1,9,0" />
                                    <TextBlock Text="{DynamicResource S.Settings.Programs.Warning.Title}"
                                               Style="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource S.Settings.Programs.Warning.Message}"
                                           Style="{StaticResource Type.CaptionWrap}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Margin="22,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource S.Settings.Programs.List}" Style="{StaticResource Type.Caption}"
                                   Margin="0,0,0,5"
                                   IsEnabled="{Binding AllowCommands}" />

                        <!--
                            LostFocus rather than PropertyChanged: this box is saved as a parsed list, and
                            saving after every keystroke would store 'gi' on the way to 'git'.
                        -->
                        <TextBox Text="{Binding AllowedCommands, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="56"
                                 MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource CodeFont}"
                                 IsEnabled="{Binding AllowCommands}"
                                 Margin="0,0,0,6" />

                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,0,0,6"
                                   IsEnabled="{Binding AllowCommands}"
                                   Text="{DynamicResource S.Settings.Programs.List.Hint}" />

                        <!--
                            cmd, powershell, pwsh, bash and wsl are not on the shipped list, and the reason
                            is worth saying once where the list is edited: adding one makes the rest of it
                            decorative, because every other program on the machine is reachable through it.
                        -->
                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="0,0,0,10"
                                   IsEnabled="{Binding AllowCommands}"
                                   Text="{DynamicResource S.Settings.Programs.List.ShellWarning}" />

                        <Border Background="{DynamicResource Brush.WarningSoft}"
                                BorderBrush="{DynamicResource Brush.Warning}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="10,7"
                                Margin="0,0,0,10"
                                Visibility="{Binding AllowedCommandsProblem, Converter={StaticResource StringToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Warning" Width="13" Height="13"
                                                   Foreground="{DynamicResource Brush.Warning}"
                                                   VerticalAlignment="Top" Margin="0,1,9,0" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Settings.Programs.CheckList}" Style="{StaticResource Type.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="{Binding AllowedCommandsProblem}" Style="{StaticResource Type.CaptionWrap}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AllowCommands}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Programs.KillAfter}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding CommandTimeoutSeconds, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding AllowCommands}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Programs.Output}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding MaxCommandOutputCharacters, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Storage ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.Storage}" />

                <Border Style="{StaticResource KcCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Storage.MaxAttachment}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding MaxAttachmentKilobytes, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Storage.LogLevel}" VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Right"
                                      MinWidth="150"
                                      ItemsSource="{Binding LogLevels}"
                                      SelectedItem="{Binding MinimumLogLevel}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Type.Caption}" Text="{DynamicResource S.Settings.Storage.KeepLogs}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInput}"
                                     Text="{Binding LogRetentionDays, Converter={StaticResource IntToText}, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Separator Margin="0,4,0,12" />

                        <TextBlock Style="{StaticResource Type.Metadata}" Text="{DynamicResource S.Settings.Storage.Database}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding DatabasePath}"
                                   FontFamily="{StaticResource CodeFont}"
                                   FontSize="{StaticResource Size.Metadata}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Settings.Storage.OpenData}" Padding="10,4"
                                    Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource KcButtonGhost}" Content="{DynamicResource S.Settings.Storage.OpenLogs}" Padding="10,4"
                                    Command="{Binding OpenLogsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Keyboard shortcuts ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.Shortcuts}" />

                <Border Style="{StaticResource KcCard}">
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Type.Caption}"
                                               VerticalAlignment="Center" />
                                    <Border Style="{StaticResource KcBadge}" HorizontalAlignment="Right" Padding="7,2">
                                        <TextBlock Style="{StaticResource KcBadgeText}"
                                                   FontFamily="{StaticResource CodeFont}"
                                                   Text="{Binding Keys}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ============ About ============ -->
                <TextBlock Style="{StaticResource SettingsSection}" Text="{DynamicResource S.Settings.About}" />

                <Border Style="{StaticResource KcCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.App.Name}" Style="{StaticResource Type.Body}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   Margin="0,2,0,10"><Run Text="{DynamicResource S.Settings.About.VersionWord}" /><Run Text=" " /><Run Text="{Binding AppVersion}" /></TextBlock>
                        <TextBlock Style="{StaticResource Type.Metadata}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Text="{DynamicResource S.Settings.About.Text}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
