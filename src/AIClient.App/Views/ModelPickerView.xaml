<UserControl x:Class="AIClient.App.Views.ModelPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModelPickerViewModel}"
             MinWidth="380"
             d:DesignHeight="520" d:DesignWidth="420">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="FilterBox"
                    Grid.Row="0"
                    Margin="6,6,6,8"
                    PlaceholderText="{DynamicResource S.Picker.Filter.Placeholder}"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="1">
            <!--
                Grouped by provider. OpenRouter alone lists several hundred models, so the
                headers are what make the list navigable rather than a wall of ids.
            -->
            <ListBox x:Name="ModelList"
                     ItemsSource="{Binding Models}"
                     SelectedItem="{Binding SelectedModel}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnModelSelected"
                     Visibility="{Binding HasNoModels, Converter={StaticResource InverseBoolToVisibility}}">

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="8,10,0,4"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Capability badges: what actually decides whether a model
                                 suits the task, without opening a docs page. -->
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Border Style="{StaticResource Badge}"
                                        Visibility="{Binding ContextWindow, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Style="{StaticResource BadgeText}"
                                               Text="{Binding ContextWindow, Converter={StaticResource ContextWindow}}" />
                                </Border>

                                <Border Style="{StaticResource Badge}"
                                        Visibility="{Binding SupportsImages, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{DynamicResource S.Picker.Vision}" />
                                </Border>

                                <Border Style="{StaticResource Badge}"
                                        Visibility="{Binding SupportsTools, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{DynamicResource S.Picker.Tools}" />
                                </Border>

                                <TextBlock Style="{StaticResource SubtleText}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Text="{Binding PromptPricePerMillion, Converter={StaticResource Price}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- No models: say what to do about it rather than showing an empty box. -->
            <StackPanel Margin="20,30"
                        Visibility="{Binding HasNoModels, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S.Picker.None.Title}"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource SubtleText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Text="{DynamicResource S.Picker.None.Hint}" />
            </StackPanel>

            <ui:ProgressRing IsIndeterminate="True"
                             Width="24" Height="24"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
