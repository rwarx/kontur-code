<UserControl x:Class="AIClient.App.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:beh="clr-namespace:AIClient.App.Behaviors"
              xmlns:views="clr-namespace:AIClient.App.Views"
              xmlns:kontur="clr-namespace:AIClient.App.Controls"
              xmlns:motion="clr-namespace:AIClient.App.Controls"
              xmlns:vm="clr-namespace:AIClient.App.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance Type=vm:FirstRunViewModel}"
              d:DesignHeight="620" d:DesignWidth="720"
              Background="{DynamicResource Brush.Surface0}"
              TextElement.Foreground="{DynamicResource Brush.TextPrimary}">

    <!-- An overlay over the shell rather than a separate window: the user sees the app they
         just launched with the setup in front of it, instead of a dialog and then a
         still-empty application behind it. -->
    <Grid>
        <Grid MaxWidth="640"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Margin="24"
              motion:Motion.Show="Rise">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Border Width="36" Height="36"
                        CornerRadius="8"
                        Background="{DynamicResource Brush.LogoPlate}"
                        Padding="6"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <Image Source="/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="Kontur Code" Style="{StaticResource Type.Title}" FontSize="17"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ===== Welcome ===== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Welcome"
                           Style="{StaticResource Type.Display}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource Type.BodyWrap}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextAlignment="Center"
                           MaxWidth="480"
                           Margin="0,0,0,22"
                           Text="A desktop client for working with AI models. Bring your own API key from a provider you already use - conversations and settings stay on this machine." />

                <Border Style="{StaticResource KcCard}" Padding="16" MaxWidth="480">
                    <StackPanel>
                        <TextBlock Text="What you get" Style="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Type.Metadata}" Margin="0,0,0,4"
                                   Text="• Streaming answers with Markdown and syntax highlighting" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Type.Metadata}" Margin="0,0,0,4"
                                   Text="• Conversations saved locally and searchable" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Type.Metadata}" Margin="0,0,0,4"
                                   Text="• Several providers side by side, behind one model picker" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Type.Metadata}"
                                   Text="• API keys encrypted with Windows DPAPI, never written to the database" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Connect a provider ===== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsConnect, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Connect a provider"
                           Style="{StaticResource Type.Title}"
                           FontSize="24"
                           Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource Type.BodyWrap}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Margin="0,0,0,18"
                           Text="Add a key for at least one provider. The others can wait - this is all repeated in Settings." />

                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KcCard}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Type.Body}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Type.Metadata}"
                                                       Text="{Binding StatusText}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <kontur:KonturIcon Kind="Refresh" Width="14" Height="14"
                                                               Foreground="{DynamicResource Brush.AccentText}"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                            <kontur:KonturIcon Kind="Check" Width="14" Height="14"
                                                               Foreground="{DynamicResource Brush.Success}"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVisibility}}" />

                                            <Button Style="{StaticResource KcButtonPrimary}" Content="Add key"
                                                    Padding="12,5"
                                                    Command="{Binding BeginEditApiKeyCommand}"
                                                    Visibility="{Binding IsEditingApiKey, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding IsEditingApiKey, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Same one-way, never-bound treatment as Settings. -->
                                            <PasswordBox Grid.Column="0"
                                                         beh:ApiKeyBox.Attach="True"
                                                         VerticalContentAlignment="Center"
                                                         Padding="8,6" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Style="{StaticResource KcButtonPrimary}" Content="Save"
                                                        Padding="12,5" Margin="0,0,6,0"
                                                        Command="{Binding SaveApiKeyCommand}" />
                                                <Button Style="{StaticResource KcButtonGhost}" Content="Cancel"
                                                        Padding="12,5"
                                                        Command="{Binding CancelEditApiKeyCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Style="{StaticResource KcLink}" Content="Get an API key"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding OpenApiKeyPageCommand}"
                                                Visibility="{Binding ApiKeyUrl, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Choose a model ===== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsChooseModel, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Choose a default model"
                           Style="{StaticResource Type.Title}"
                           FontSize="24"
                           Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource Type.BodyWrap}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Margin="0,0,0,18"
                           Text="New chats start with this model. It can be changed per chat from the composer." />

                <Border BorderThickness="1"
                        CornerRadius="{StaticResource Radius.MD}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        Background="{DynamicResource Brush.Surface1}"
                        Padding="4">
                    <!-- The same picker control as the composer, on the wizard's own
                         ViewModel instance, so a choice here is already the app's choice. -->
                    <views:ModelPickerView DataContext="{Binding ModelPicker}"
                                           MaxHeight="300" />
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Button Style="{StaticResource KcButtonGhost}" Content="Skip setup"
                        HorizontalAlignment="Left"
                        Command="{Binding SkipCommand}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource KcButtonGhost}" Content="Back"
                            MinWidth="90" Padding="12,5"
                            Margin="0,0,8,0"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource KcButtonPrimary}" Content="{Binding PrimaryButtonText}"
                            MinWidth="130" Padding="12,5"
                            Command="{Binding NextCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
