<UserControl x:Class="AIClient.App.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:AIClient.App.Behaviors"
             xmlns:views="clr-namespace:AIClient.App.Views"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FirstRunViewModel}"
             d:DesignHeight="620" d:DesignWidth="720">

    <!-- An overlay over the shell rather than a separate window: the user sees the app they
         just launched with the setup in front of it, instead of a dialog and then a
         still-empty application behind it. -->
    <Grid Background="{DynamicResource BgBaseBrush}">

        <Grid MaxWidth="640"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource SubtleText}"
                       Margin="0,0,0,10"
                       Text="{Binding StepText}" />

            <!-- ===== Welcome ===== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S.FirstRun.Welcome.Title}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource FontUiDisplay}"
                           Margin="0,0,0,10" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,22"
                           Text="{DynamicResource S.FirstRun.Welcome.Intro}" />

                <Border Style="{StaticResource GroupBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.FirstRun.Welcome.Get.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="{DynamicResource S.FirstRun.Welcome.Get.1}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="{DynamicResource S.FirstRun.Welcome.Get.2}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="{DynamicResource S.FirstRun.Welcome.Get.3}" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{DynamicResource S.FirstRun.Welcome.Get.4}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Connect a provider ===== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsConnect, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S.FirstRun.Connect.Title}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,18"
                           Text="{DynamicResource S.FirstRun.Connect.Intro}" />

                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GroupBorder}" Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource SubtleText}"
                                                       Text="{Binding StatusText}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ProgressRing IsIndeterminate="True"
                                                             Width="18" Height="18"
                                                             Margin="0,0,10,0"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVisibility}}" />

                                            <ui:Button Content="{DynamicResource S.Provider.AddKey}"
                                                       Appearance="Primary"
                                                       Command="{Binding BeginEditApiKeyCommand}"
                                                       Visibility="{Binding IsEditingApiKey, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding IsEditingApiKey, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Same one-way, never-bound treatment as Settings. -->
                                            <PasswordBox Grid.Column="0"
                                                         beh:ApiKeyBox.Attach="True"
                                                         VerticalContentAlignment="Center"
                                                         Padding="8,7" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <ui:Button Content="{DynamicResource S.Common.Save}"
                                                           Appearance="Primary"
                                                           Margin="0,0,6,0"
                                                           Command="{Binding SaveApiKeyCommand}" />
                                                <ui:Button Content="{DynamicResource S.Common.Cancel}"
                                                           Command="{Binding CancelEditApiKeyCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <ui:Button Content="{DynamicResource S.Provider.GetKey}"
                                                   Appearance="Transparent"
                                                   Margin="0,6,0,0"
                                                   Padding="0,4"
                                                   Command="{Binding OpenApiKeyPageCommand}"
                                                   Visibility="{Binding ApiKeyUrl, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Choose a model ===== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsChooseModel, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S.FirstRun.Model.Title}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,18"
                           Text="{DynamicResource S.FirstRun.Model.Intro}" />

                <Border Style="{StaticResource GroupBorder}"
                        Padding="4">
                    <!-- The same picker control as the chat header, on the wizard's own
                         ViewModel instance, so a choice here is already the app's choice. -->
                    <views:ModelPickerView DataContext="{Binding ModelPicker}"
                                           MaxHeight="300" />
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <ui:Button Content="{DynamicResource S.FirstRun.Skip}"
                           Appearance="Transparent"
                           HorizontalAlignment="Left"
                           Command="{Binding SkipCommand}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{DynamicResource S.Common.Back}"
                               MinWidth="90"
                               Margin="0,0,8,0"
                               Command="{Binding BackCommand}"
                               Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="{Binding PrimaryButtonText}"
                               Appearance="Primary"
                               MinWidth="130"
                               Command="{Binding NextCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
