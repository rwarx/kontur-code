<ui:FluentWindow x:Class="AIClient.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:AIClient.App.Views"
                 xmlns:canvas="clr-namespace:AIClient.App.Views.Canvas"
                 xmlns:vm="clr-namespace:AIClient.App.ViewModels"
                 xmlns:app="clr-namespace:AIClient.Application.Interfaces;assembly=AIClient.Application"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Kontur Code"
                 Width="1240" Height="820"
                 MinWidth="760" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <!--
        Section 23. Declared on the window rather than per view, so a shortcut works wherever
        focus happens to be. Enter and Shift+Enter are not here: they are only meaningful
        inside the composer and are handled there.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewChatCommand}" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding ShowCanvasCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding Chat.ToggleVoiceInputCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Chat.StopCommand}" />
    </ui:FluentWindow.InputBindings>

    <!--
        Shell typography: one font family cascades to everything inside the window through
        TextElement inheritance, including popup content, which resolves it through the
        logical tree. Product typography lives in Shared.xaml with the rest of the tokens.
    -->
    <Grid TextElement.FontFamily="{StaticResource FontUi}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource S.App.Name}"
                     Icon="{ui:SymbolIcon Sparkle24}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="220" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <views:SidebarView x:Name="Sidebar"
                               Grid.Column="0"
                               Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <GridSplitter Grid.Column="1"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderSubtleBrush}"
                          Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Main area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section 31: connectivity is a strip, not a modal. Saved conversations,
                     settings and the local database all stay usable while it is showing. -->
                <ui:InfoBar Grid.Row="0"
                            Severity="Warning"
                            IsClosable="False"
                            Margin="16,8,16,0"
                            Title="{DynamicResource S.Main.Offline.Title}"
                            Message="{DynamicResource S.Main.Offline.Message}"
                            IsOpen="{Binding IsOffline}" />

                <!--
                    Session header. The session on screen, the model that answers, and the
                    three per-conversation tools - nothing else earns a place up here.
                -->
                <Border Grid.Row="1"
                        Height="46"
                        Padding="12,0,10,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Visibility="{Binding IsChatVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0"
                                   Style="{StaticResource IconButton}"
                                   Icon="{ui:SymbolIcon PanelLeft24}"
                                   ToolTip="{DynamicResource S.Main.ToggleSidebar.ToolTip}"
                                   Command="{Binding ToggleSidebarCommand}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Chat.Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="6,0,12,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">

                            <!-- Model selector. A popup rather than a ComboBox: the list needs
                                 a filter box and provider grouping, and a combo cannot host
                                 either without fighting its own keyboard handling. -->
                            <ui:Button x:Name="ModelButton"
                                       Style="{StaticResource HeaderChipButton}"
                                       Margin="0,0,4,0"
                                       ToolTip="{DynamicResource S.Main.ChangeModel.ToolTip}"
                                       Click="OnModelButtonClick">
                                <StackPanel Orientation="Horizontal">
                                    <!-- The no-model sentence lives in a style trigger rather than a
                                         TargetNullValue, so it follows the active language. -->
                                    <TextBlock MaxWidth="230"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="Text" Value="{Binding Chat.SelectedModel.Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Chat.SelectedModel}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{DynamicResource S.Main.SelectModel}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:SymbolIcon Symbol="ChevronDown24"
                                                   FontSize="12"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </ui:Button>

                            <!--
                                The context report. A flyout rather than a page: it answers a question
                                about the conversation on screen, and sending the user somewhere else to
                                read how full the window is would lose the thing they were looking at.
                                Bound to the command, not to a Click handler, because the report has to
                                be built before the panel is shown - the command raises the request once
                                it has one, and the window opens the flyout then.
                            -->
                            <ui:Button x:Name="ContextButton"
                                       Style="{StaticResource IconButton}"
                                       Icon="{ui:SymbolIcon DataHistogram24}"
                                       ToolTip="{DynamicResource S.Main.Context.ToolTip}"
                                       Command="{Binding ShowContextCommand}" />

                            <ui:Button Style="{StaticResource IconButton}"
                                       Icon="{ui:SymbolIcon ArrowExportLtr24}"
                                       ToolTip="{DynamicResource S.Main.Export.ToolTip}"
                                       Click="OnExportButtonClick">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource S.Main.Export.Markdown}"
                                                  Command="{Binding ExportCommand}"
                                                  CommandParameter="{x:Static app:ExportFormat.Markdown}" />
                                        <MenuItem Header="{DynamicResource S.Main.Export.Json}"
                                                  Command="{Binding ExportCommand}"
                                                  CommandParameter="{x:Static app:ExportFormat.Json}" />
                                        <MenuItem Header="{DynamicResource S.Main.Export.Text}"
                                                  Command="{Binding ExportCommand}"
                                                  CommandParameter="{x:Static app:ExportFormat.PlainText}" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>

                            <ui:Button Style="{StaticResource IconButton}"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       ToolTip="{DynamicResource S.Main.Settings.ToolTip}"
                                       Command="{Binding ShowSettingsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <views:ChatView Grid.Row="2"
                                DataContext="{Binding Chat}"
                                Visibility="{Binding DataContext.IsChatVisible,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVisibility}}" />

                <views:SettingsView Grid.Row="1"
                                    Grid.RowSpan="2"
                                    DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettingsVisible,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolToVisibility}}" />

                <!--
                    The canvas takes the whole main area, chat header included: a spatial view of the
                    graph is not a page with a title bar, and the header's model picker belongs to a
                    conversation. Two columns rather than a splitter, because the inspector has one
                    width and collapses itself - an auto column is what hands that space back.
                -->
                <Grid Grid.Row="1"
                      Grid.RowSpan="2"
                      Visibility="{Binding DataContext.IsCanvasVisible,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <canvas:CanvasView Grid.Column="0" DataContext="{Binding Canvas}" />

                    <views:InspectorView Grid.Column="1" DataContext="{Binding Inspector}" />
                </Grid>
            </Grid>
        </Grid>

        <!--
            Overlays cover the content, deliberately not the title bar. Spanning both rows
            hides the caption buttons, which leaves the window with no visible way to minimise
            or close it while the wizard is up - it reads as a broken window rather than a
            modal one. The dialog host is the exception below, and always carries its own
            dismiss button.
        -->
        <views:CommandPaletteView x:Name="CommandPalette"
                                  Grid.Row="1"
                                  DataContext="{Binding CommandPalette}"
                                  Visibility="{Binding DataContext.IsCommandPaletteOpen,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource BoolToVisibility}}" />

        <views:FirstRunView Grid.Row="1"
                            DataContext="{Binding FirstRun}"
                            Visibility="{Binding DataContext.IsFirstRunVisible,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />

        <!-- Hosts for the WPF-UI services resolved through DI; both are wired in the
             constructor, because the services need the element and not the other way round.
             ContentDialogHost rather than a bare ContentPresenter: it disables the rest of the
             shell while a dialog is up, so a confirmation cannot be clicked around. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />

        <ui:SnackbarPresenter x:Name="SnackbarHost"
                              Grid.Row="1"
                              Margin="0,0,0,18"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Center" />

        <Popup x:Name="ModelPopup"
               PlacementTarget="{Binding ElementName=ModelButton}"
               Placement="Bottom"
               VerticalOffset="6"
               HorizontalOffset="-300"
               StaysOpen="False"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">
            <Border Style="{StaticResource FlyoutBorder}" Margin="12" Padding="4">
                <views:ModelPickerView x:Name="ModelPicker"
                                       Width="440"
                                       MaxHeight="460"
                                       DataContext="{Binding ModelPicker}" />
            </Border>
        </Popup>

        <!-- Same shape as the model flyout above, and for the same reason: a panel that dismisses
             itself on the next click outside it, so reading the numbers costs one keystroke to
             open and none to leave. -->
        <Popup x:Name="ContextPopup"
               PlacementTarget="{Binding ElementName=ContextButton}"
               Placement="Bottom"
               VerticalOffset="6"
               HorizontalOffset="-340"
               StaysOpen="False"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">
            <Border Style="{StaticResource FlyoutBorder}" Margin="12" Padding="4">
                <views:SessionContextView Width="400"
                                          MaxHeight="620"
                                          DataContext="{Binding SessionContext}" />
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
