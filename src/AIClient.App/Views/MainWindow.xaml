<ui:FluentWindow x:Class="AIClient.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:AIClient.App.Views"
                 xmlns:kontur="clr-namespace:AIClient.App.Controls"
                 xmlns:vm="clr-namespace:AIClient.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Kontur Code"
                 Width="1360" Height="860"
                 MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource Brush.Surface0}">

    <!--
        Declared on the window rather than per view, so a shortcut works wherever focus
        happens to be. Enter and Shift+Enter stay in the composer; Ctrl+Z/Y belong to
        whatever has focus, which is why they are not here.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewChatCommand}" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding AskAiAboutSelectionCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Chat.StopCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title bar content: identity, workspace, model, AI state, search, palette. -->
            <RowDefinition Height="40" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The top bar. WPF-UI's TitleBar provides the drag region and the caption
            buttons; everything the product needs in the title row sits on top of it as
            an overlay whose container is deliberately transparent-null so the empty
            stretches keep dragging the window. The right padding reserves the caption
            buttons' width so nothing important is ever minimized by accident.
        -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.Surface1}">
            <ui:TitleBar Title="" Icon="" ShowMaximize="True" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="142" />
                </Grid.ColumnDefinitions>

                <!-- Identity. The mark and the name; the one place the product is loud
                     about being itself. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <kontur:KonturIcon Kind="Logo" Width="18" Height="18" GlyphThickness="2"
                                       Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Kontur Code" Style="{StaticResource Type.Title}" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Workspace chip: the folder everything on screen refers to. -->
                <Button Grid.Column="1" Style="{StaticResource KcButtonGhost}" Margin="16,0,0,0"
                        Padding="9,4" MinHeight="26"
                        ToolTip="{Binding Workspace.WorkspaceRoot, FallbackValue='Open a workspace folder'}"
                        Command="{Binding Workspace.OpenWorkspaceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <kontur:KonturIcon Kind="Folder" Width="13" Height="13"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding Workspace.WorkspaceName, FallbackValue='No workspace'}"
                                   Style="{StaticResource Type.Caption}" Margin="7,0,0,0" MaxWidth="180"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- AI state: quiet unless there is something to say. A running agent is
                     the one thing worth a coloured dot in the title row. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,12,0" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                             Fill="{DynamicResource Brush.Success}" />
                    <TextBlock Text="{Binding Workspace.Context.AiStateText, FallbackValue='Idle'}"
                               Style="{StaticResource Type.Metadata}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Workspace.Context.AiModelName, TargetNullValue=''}"
                               Style="{StaticResource Type.Metadata}" Opacity="0.55" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Model chip + search + palette, ending before the caption buttons. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ModelButton" Style="{StaticResource KcButtonGhost}" Padding="9,4" MinHeight="26"
                            Margin="0,0,4,0" Click="OnModelButtonClick" ToolTip="Change model">
                        <StackPanel Orientation="Horizontal">
                            <kontur:KonturIcon Kind="Models" Width="13" Height="13"
                                               Foreground="{DynamicResource Brush.AccentText}" />
                            <TextBlock Text="{Binding Chat.SelectedModel.Name, FallbackValue='Select a model', TargetNullValue='Select a model'}"
                                       Style="{StaticResource Type.Caption}" MaxWidth="200" Margin="7,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <kontur:KonturIcon Kind="ChevronDown" Width="10" Height="10" GlyphThickness="1.8"
                                               Foreground="{DynamicResource Brush.TextMuted}" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource KcButtonTool}" Command="{Binding ToggleCommandPaletteCommand}"
                            ToolTip="Command palette (Ctrl+Shift+P)">
                        <kontur:KonturIcon Kind="Command" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The body: sidebar | workspace | context surface, all user-resizable. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="232" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="ContextSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="ContextColumn" Width="320" MinWidth="280" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <views:SidebarView x:Name="Sidebar" Grid.Column="0"
                               Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <GridSplitter Grid.Column="1" Style="{StaticResource KcSplitV}"
                          Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <views:WorkspaceView Grid.Column="2" x:Name="WorkspaceHost" />

            <GridSplitter x:Name="ContextSplitter" Grid.Column="3" Style="{StaticResource KcSplitV}"
                          Visibility="{Binding IsContextPanelVisible, Converter={StaticResource BoolToVisibility}}" />

            <views:ContextPanelView x:Name="ContextPanel" Grid.Column="4"
                                    Visibility="{Binding IsContextPanelVisible, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <views:StatusBarView Grid.Row="2" />

        <!--
            Overlays cover the body, not the title row: spanning everything would hide
            the caption buttons and leave the window with no visible way to close itself.
        -->
        <views:CommandPaletteView x:Name="CommandPalette" Grid.Row="1"
                                  DataContext="{Binding CommandPalette}"
                                  Visibility="{Binding DataContext.IsCommandPaletteOpen,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource BoolToVisibility}}" />

        <views:FirstRunView Grid.Row="0" Grid.RowSpan="3"
                            DataContext="{Binding FirstRun}"
                            Visibility="{Binding DataContext.IsFirstRunVisible,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />

        <!-- WPF-UI service hosts: wired in the constructor, before any dialog is shown. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3" />

        <ui:SnackbarPresenter x:Name="SnackbarHost"
                              Grid.Row="2"
                              Margin="0,0,0,26"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Center" />

        <Popup x:Name="ModelPopup"
               PlacementTarget="{Binding ElementName=ModelButton}"
               Placement="Bottom"
               VerticalOffset="4"
               HorizontalOffset="-264"
               StaysOpen="False"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface3}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="12"
                    Padding="4"
                    Effect="{StaticResource Shadow.Overlay}">
                <views:ModelPickerView x:Name="ModelPicker"
                                       Width="440"
                                       MaxHeight="460"
                                       DataContext="{Binding ModelPicker}" />
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
