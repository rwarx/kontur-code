<ui:FluentWindow x:Class="AIClient.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:views="clr-namespace:AIClient.App.Views"
                  xmlns:kontur="clr-namespace:AIClient.App.Controls"
                  xmlns:motion="clr-namespace:AIClient.App.Controls"
                  xmlns:vm="clr-namespace:AIClient.App.ViewModels"
                  xmlns:loc="clr-namespace:AIClient.App.Markup"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="{DynamicResource S.App.Name}"
                 Width="1360" Height="860"
                 MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource Brush.Surface0}">

    <!--
        Declared on the window rather than per view, so a shortcut works wherever focus
        happens to be. Enter and Shift+Enter stay in the composer; Ctrl+Z/Y belong to
        whatever has focus, which is why they are not here.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewChatCommand}" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding AskAiAboutSelectionCommand}" />
        <KeyBinding Key="I" Modifiers="Ctrl+Alt" Command="{Binding ToggleContextPanelCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding GoForwardCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Chat.StopCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title bar content: identity, workspace, AI state, search, model. -->
            <RowDefinition Height="40" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The top bar. WPF-UI's TitleBar owns the drag band and the caption buttons, and
            it owns them at the Win32 level: it hooks WM_NCHITTEST and answers HTCAPTION for
            every point over itself except the points over its Header, CenterContent and
            TrailingContent slots. A control merely drawn on top of the title bar - an
            overlay Grid, say - is invisible to that test, so Windows takes the press as a
            window drag and WPF never sees a click. WindowChrome.IsHitTestVisibleInChrome
            cannot rescue it: the hook marks the message handled before the chrome worker
            is ever consulted.

            So everything the product needs in this row lives in the three slots, and each
            slot is sized to its content rather than stretched - the test is the slot's
            bounding rectangle, and a stretched slot would claim the whole band and leave
            the window with nowhere left to drag by.
        -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.Surface1}">
            <ui:TitleBar Height="40"
                         Title="{x:Null}"
                         Icon="{x:Null}"
                         ShowMaximize="True"
                         HorizontalContentAlignment="Center">

                <!--
                    Identity, the folder everything on screen refers to, and how busy the
                    model is. A null title and icon collapse the control's own title block,
                    which would otherwise hold the leading 32px of padding.

                    The first control is the sidebar's toggle, parked where the bar it
                    opens and closes used to live: once the sidebar hides itself (Ctrl+B
                    or its own button), it takes its only clickable affordance with it,
                    so the way back has to live outside the thing that disappears.
                -->
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource KcButtonTool}" Width="26" Height="26"
                                Margin="0,0,8,0"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="{DynamicResource S.Main.ToggleSidebar.ToolTip}">
                            <kontur:MorphIcon First="CollapsePanel" Second="ExpandPanel"
                                              IsSecond="{Binding IsSidebarVisible, Converter={StaticResource InverseBool}}"
                                              Width="13" Height="13" />
                        </Button>
                        <Border Width="28" Height="28"
                                CornerRadius="6"
                                Background="{DynamicResource Brush.LogoPlate}"
                                Padding="5"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Image Source="/Assets/logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="{DynamicResource S.App.Name}" Style="{StaticResource Type.Title}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />

                        <Button Style="{StaticResource KcButtonGhost}" Margin="16,0,0,0"
                                Padding="9,4" MinHeight="26"
                                ToolTip="{Binding Workspace.WorkspaceRoot, FallbackValue={loc:Loc S.Main.Workspace.OpenFallback}}"
                                Command="{Binding Workspace.OpenWorkspaceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Folder" Width="13" Height="13"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding Workspace.WorkspaceName, FallbackValue={loc:Loc S.Main.Workspace.None}}"
                                           Style="{StaticResource Type.Caption}" Margin="7,0,0,0" MaxWidth="160"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- AI state: quiet unless there is something to say. A running agent
                              is the one thing worth a coloured dot in the title row, and the
                              dot breathes while it runs - alive, but not an alarm. -->
                        <Ellipse x:Name="AiStateDot" Width="7" Height="7" VerticalAlignment="Center" Margin="16,0,6,0"
                                 Fill="{DynamicResource Brush.Success}">
                            <motion:Motion.Pulse>
                                <Binding Path="Workspace.Context.IsAiWorking" />
                            </motion:Motion.Pulse>
                        </Ellipse>
                        <TextBlock Text="{Binding Workspace.Context.AiStateText, FallbackValue={loc:Loc S.Main.Ai.Idle}}"
                                   Style="{StaticResource Type.Metadata}" VerticalAlignment="Center"
                                   MaxWidth="140" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:TitleBar.Header>

                <!--
                    VS Code-style command bar: back and forward walk the mode history, the
                    field opens the palette (search + commands). The centre slot is sized to
                    this cluster and no wider, so the band either side of it still drags the
                    window.
                -->
                <ui:TitleBar.CenterContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource KcButtonTool}" Width="26" Height="26"
                                Command="{Binding GoBackCommand}" ToolTip="{DynamicResource S.Main.GoBack.ToolTip}">
                            <kontur:KonturIcon Kind="ChevronLeft" Width="13" Height="13" GlyphThickness="2.4" />
                        </Button>
                        <Button Style="{StaticResource KcButtonTool}" Width="26" Height="26" Margin="1,0,0,0"
                                Command="{Binding GoForwardCommand}" ToolTip="{DynamicResource S.Main.GoForward.ToolTip}">
                            <kontur:KonturIcon Kind="ChevronRight" Width="13" Height="13" GlyphThickness="2.4" />
                        </Button>

                        <Button Style="{StaticResource KcButtonGhost}" Padding="0" Margin="8,0,0,0"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding ToggleCommandPaletteCommand}"
                                ToolTip="{DynamicResource S.Main.Palette.ToolTip}">
                            <Border Background="{DynamicResource Brush.SurfaceSunken}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.SM}"
                                    Width="320" Height="26" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <kontur:KonturIcon Grid.Column="0" Kind="Search" Width="13" Height="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource S.Main.Search.Placeholder}"
                                               Style="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource Type.Keycap}" Padding="5,1">
                                        <TextBlock Text="Ctrl+Shift+P" Style="{StaticResource Type.KeycapText}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>
                </ui:TitleBar.CenterContent>

                <!-- Model chip: the active model, ending just before the caption buttons. -->
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource KcButtonGhost}" Padding="8,4" MinHeight="26"
                                Margin="0,0,4,0"                                 Command="{Binding ToggleContextPanelCommand}"
                                ToolTip="{DynamicResource S.Main.Inspector.ToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:MorphIcon First="ExpandPanel" Second="CollapsePanel"
                                                  IsSecond="{Binding IsContextPanelVisible}"
                                                  Width="13" Height="13">
                                    <kontur:MorphIcon.Style>
                                        <Style TargetType="kontur:MorphIcon"
                                               BasedOn="{StaticResource {x:Type kontur:MorphIcon}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContextPanelVisible}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </kontur:MorphIcon.Style>
                                </kontur:MorphIcon>
                                <TextBlock Text="{DynamicResource S.Main.Inspector}" Style="{StaticResource Type.Caption}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ModelButton" Style="{StaticResource KcButtonGhost}" Padding="9,4"
                                MinHeight="26" Margin="0,0,8,0" VerticalAlignment="Center"
                                Click="OnModelButtonClick" ToolTip="{DynamicResource S.Main.ChangeModel.ToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <kontur:KonturIcon Kind="Models" Width="13" Height="13"
                                                   Foreground="{DynamicResource Brush.AccentText}" />
                                <TextBlock Text="{Binding Chat.SelectedModel.Name, FallbackValue={loc:Loc S.Main.SelectModel}, TargetNullValue={loc:Loc S.Main.SelectModel}}"
                                           Style="{StaticResource Type.Caption}" MaxWidth="180" Margin="7,0,0,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <kontur:KonturIcon Kind="ChevronDown" Width="10" Height="10" GlyphThickness="2.7"
                                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="6,1,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <!-- The body: sidebar | workspace | context surface, all user-resizable. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="232" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="ContextSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="ContextColumn" Width="320" MinWidth="280" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <views:SidebarView x:Name="Sidebar" Grid.Column="0"
                               Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <GridSplitter Grid.Column="1" Style="{StaticResource KcSplitV}"
                          Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <views:WorkspaceView Grid.Column="2" x:Name="WorkspaceHost" />

            <GridSplitter x:Name="ContextSplitter" Grid.Column="3" Style="{StaticResource KcSplitV}"
                          Visibility="{Binding IsContextPanelVisible, Converter={StaticResource BoolToVisibility}}" />

            <views:ContextPanelView x:Name="ContextPanel" Grid.Column="4"
                                    DataContext="{Binding Workspace.Context}"
                                    Visibility="{Binding DataContext.IsContextPanelVisible,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <views:StatusBarView Grid.Row="2" />

        <!--
            Overlays cover the body, not the title row: spanning everything would hide
            the caption buttons and leave the window with no visible way to close itself.
            Their stacking is stated rather than inferred from declaration order, because
            the dialog host is declared last and would otherwise paint over the palette.

            The palette's visibility is driven from the code-behind. A RelativeSource
            binding that fails to resolve yields Collapsed in silence, and a search field
            that opens nothing is indistinguishable from a search field that never got
            the click - the failure this row already had once.
        -->
        <views:CommandPaletteView x:Name="CommandPalette" Grid.Row="1"
                                  Panel.ZIndex="20"
                                  Visibility="Collapsed"
                                  DataContext="{Binding CommandPalette}" />

        <views:FirstRunView Grid.Row="0" Grid.RowSpan="3"
                            Panel.ZIndex="30"
                            DataContext="{Binding FirstRun}"
                            Visibility="{Binding DataContext.IsFirstRunVisible,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />

        <!-- WPF-UI service hosts: wired in the constructor, before any dialog is shown. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="40" />

        <ui:SnackbarPresenter x:Name="SnackbarHost"
                              Grid.Row="2"
                              Panel.ZIndex="50"
                              Margin="0,0,0,26"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Center" />

        <Popup x:Name="ModelPopup"
               PlacementTarget="{Binding ElementName=ModelButton}"
               Placement="Bottom"
               VerticalOffset="4"
               HorizontalOffset="-264"
               StaysOpen="False"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface3}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="12"
                    Padding="4"
                    Effect="{StaticResource Shadow.Overlay}">
                <views:ModelPickerView x:Name="ModelPicker"
                                       Width="440"
                                       MaxHeight="460"
                                       DataContext="{Binding ModelPicker}" />
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
