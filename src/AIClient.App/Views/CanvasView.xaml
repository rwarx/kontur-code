<UserControl x:Class="AIClient.App.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:canvas="clr-namespace:AIClient.App.Canvas"
              xmlns:kontur="clr-namespace:AIClient.App.Controls"
              xmlns:motion="clr-namespace:AIClient.App.Controls"
              xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WorkspaceViewModel}">

    <!--
        The canvas mode: the renderer element, a floating toolbar, the minimap, and an
        empty state that offers the two things an empty canvas can honestly do - open a
        workspace, or ask for a plan. The toolbar floats over the canvas rather than
        sitting in a chrome bar: every pixel of a dedicated spatial surface should belong
        to the space, with tools appearing where the hands already are.
    -->
    <Grid>
        <canvas:GraphCanvas x:Name="Surface" />

        <!--
            Canvas controls: bottom-center, over the workflow, the way the previous
            interface placed them. Pointer and hand are a radio pair (one tool at a time);
            the rest are momentary actions. The bar floats so the spatial surface keeps
            every pixel it can.
        -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}"
                Padding="3,2"
                Effect="{StaticResource Shadow.Subtle}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource KcToggle}" GroupName="CanvasTool"
                             Width="30" Height="28" Padding="0"
                             IsChecked="{Binding Canvas.IsSelectTool, Mode=OneWay}"
                             Command="{Binding Canvas.UseSelectToolCommand}"
                             ToolTip="{DynamicResource S.Canvas.Tool.Select.Tip}">
                    <kontur:KonturIcon Kind="Pointer" Width="14" Height="14" />
                </RadioButton>
                <RadioButton Style="{StaticResource KcToggle}" GroupName="CanvasTool"
                             Width="30" Height="28" Padding="0"
                             IsChecked="{Binding Canvas.IsPanTool, Mode=OneWay}"
                             Command="{Binding Canvas.UsePanToolCommand}"
                             ToolTip="{DynamicResource S.Canvas.Tool.Pan.Tip}">
                    <kontur:KonturIcon Kind="Hand" Width="14" Height="14" />
                </RadioButton>
                <Separator Margin="2,4" />
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding Canvas.ZoomOutCommand}"
                        ToolTip="{DynamicResource S.Canvas.Tool.ZoomOut.Tip}">
                    <kontur:KonturIcon Kind="ZoomOut" Width="13" Height="13" />
                </Button>
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding Canvas.ZoomResetCommand}"
                        ToolTip="{DynamicResource S.Canvas.Tool.ZoomReset.Tip}">
                    <TextBlock Text="{Binding Canvas.ZoomPercent, StringFormat={}{0:0}%}"
                               Style="{StaticResource Type.Metadata}" MinWidth="38"
                               HorizontalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding Canvas.ZoomInCommand}"
                        ToolTip="{DynamicResource S.Canvas.Tool.ZoomIn.Tip}">
                    <kontur:KonturIcon Kind="ZoomIn" Width="13" Height="13" />
                </Button>
                <Separator Margin="2,4" />
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding Canvas.FocusSelectionCommand}"
                        ToolTip="{DynamicResource S.Canvas.Tool.Focus.Tip}">
                    <kontur:KonturIcon Kind="Focus" Width="13" Height="13" />
                </Button>
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding Canvas.FitCommand}"
                        ToolTip="{DynamicResource S.Canvas.Tool.Fit.Tip}">
                    <kontur:KonturIcon Kind="Fit" Width="13" Height="13" />
                </Button>
                <Separator Margin="2,4" />
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding Canvas.AutoLayoutCommand}"
                        ToolTip="{DynamicResource S.Canvas.AutoLayout}">
                    <kontur:KonturIcon Kind="AutoLayout" Width="14" Height="14" />
                </Button>
                <Separator Margin="2,4" />
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding Canvas.AskAiCommand}"
                        ToolTip="{DynamicResource S.Canvas.Tool.Ask.Tip}">
                    <kontur:KonturIcon Kind="Sparkle" Width="13" Height="13"
                                       Foreground="{DynamicResource Brush.AccentText}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Minimap: bottom-right, out of the working area's way. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                Background="{DynamicResource Brush.OverlayPanel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}"
                Padding="4"
                Effect="{StaticResource Shadow.Subtle}"
                Visibility="{Binding Canvas.NodeCount, Converter={StaticResource NodeCountToVisibility}}">
            <canvas:CanvasMinimap x:Name="MiniMap" />
        </Border>

        <!-- Live stats chip: bottom-left, quiet. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                Background="{DynamicResource Brush.OverlayPanel}"
                BorderBrush="{DynamicResource Brush.BorderFaint}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.SM}"
                Padding="8,4"
                Visibility="{Binding Canvas.NodeCount, Converter={StaticResource NodeCountToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Type.Metadata}">
                    <Run Text="{Binding Canvas.NodeCount}" /><Run Text=" " /><Run Text="{DynamicResource S.Canvas.Unit.Nodes}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Type.Metadata}" Opacity="0.6" Text=" · " />
                <TextBlock Style="{StaticResource Type.Metadata}">
                    <Run Text="{Binding Canvas.EdgeCount}" /><Run Text=" " /><Run Text="{DynamicResource S.Canvas.Unit.Links}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Type.Metadata}" Opacity="0.6" Text=" · "
                           Visibility="{Binding Canvas.HasSelection, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Type.Accent}"
                           Text="{Binding Canvas.SelectionSummary}"
                           Visibility="{Binding Canvas.HasSelection, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Indexing pulse: top-left while the workspace is being read. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Background="{DynamicResource Brush.OverlayPanel}"
                BorderBrush="{DynamicResource Brush.AccentBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.SM}"
                Padding="8,4"
                Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <kontur:KonturIcon Kind="Refresh" Width="12" Height="12"
                                   Foreground="{DynamicResource Brush.AccentText}"
                                   motion:Motion.Spin="True" />
                <TextBlock Text="{DynamicResource S.Canvas.Status.IndexingWorkspace}" Style="{StaticResource Type.Metadata}" Margin="7,0,0,0" />
            </StackPanel>
        </Border>

        <!--
            The empty state. An empty canvas is a door, not a wall: the two honest next
            actions are opening a workspace (the graph gets built) and asking the agent
            for a plan (PlanCanvas mode draws one). Everything else is noise.
        -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Surface1}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.LG}"
                Padding="28,24"
                motion:Motion.Show="Rise"
                Visibility="{Binding Canvas.NodeCount, Converter={StaticResource NodeCountToVisibility}, ConverterParameter=invert}">
            <StackPanel MaxWidth="380">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <kontur:KonturIcon Kind="Canvas" Width="34" Height="34" GlyphThickness="1.65"
                                       Foreground="{DynamicResource Brush.Accent}" />
                </StackPanel>
                <TextBlock Text="{DynamicResource S.Canvas.Blank.Title}"
                           Style="{StaticResource Type.Section}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Type.CaptionWrap}" Margin="0,6,0,0" TextAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="{DynamicResource S.Canvas.Blank.Hint}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource KcButtonPrimary}" Padding="14,8"
                            Command="{Binding OpenWorkspaceCommand}" MinWidth="150">
                        <TextBlock Text="{DynamicResource S.Canvas.Blank.Open}" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource KcButtonGhost}" Padding="14,8" Margin="8,0,0,0" MinWidth="150"
                            Command="{Binding AskForPlanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <kontur:KonturIcon Kind="Sparkle" Width="13" Height="13" />
                            <TextBlock Text="{DynamicResource S.Canvas.Blank.AskPlan}" Style="{StaticResource Type.Caption}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
