<UserControl x:Class="AIClient.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AIClient.App.Views"
             xmlns:kontur="clr-namespace:AIClient.App.Controls"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{DynamicResource Brush.Surface0}"
             TextElement.Foreground="{DynamicResource Brush.TextPrimary}">

    <!--
        The workspace's one content area. Modes are visibility switches over live views
        rather than page swaps: the canvas keeps its viewport, code keeps its tabs and
        scroll, chat keeps its transcript, because their views never unload.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Offline strip: a strip, not a modal - everything below stays usable. -->
            <RowDefinition Height="Auto" />
            <!-- Mode header: tabs or page title. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.WarningSoft}"
                BorderBrush="{DynamicResource Brush.Warning}"
                BorderThickness="0,0,0,1"
                Padding="12,5"
                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Type.Caption}"
                       Foreground="{DynamicResource Brush.Warning}"
                       Text="No internet connection. Saved conversations, the workspace and settings stay available; new messages will fail until it returns." />
        </Border>

        <!--
            The mode strip: the five spatial/code modes as tabs, or a page header for the
            three full surfaces. An underline, not a boxed control - the workspace is one
            surface changing content, and chrome here would outrank the canvas itself.
        -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource Brush.Surface1}">
            <Grid Margin="8,0,8,0">
                <ListBox x:Name="ModeTabs" Style="{StaticResource KcTabs}"
                         ItemContainerStyle="{StaticResource KcTab}"
                         SelectionChanged="OnModeTabSelected"
                         Visibility="{Binding Workspace.IsSpatialMode, Converter={StaticResource BoolToVisibility}}" />

                <!-- Page header for Models / Tasks / Settings. -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding Workspace.IsSpatialMode, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button Style="{StaticResource KcButtonGhost}" Padding="8,5" Margin="0,4,4,4"
                            Click="OnBackToCanvas" ToolTip="Back to the canvas">
                        <StackPanel Orientation="Horizontal">
                            <kontur:KonturIcon Kind="ChevronLeft" Width="12" Height="12" />
                            <TextBlock Text="Workspace" Style="{StaticResource Type.Caption}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource Type.Section}" Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The modes. All alive; exactly one visible. -->
        <Grid Grid.Row="2">
            <views:CanvasView x:Name="CanvasPane"
                              DataContext="{Binding Workspace}"
                              Visibility="{Binding Workspace.Mode, Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Canvas}" />

            <views:GraphOutlineView x:Name="OutlinePane"
                                    Visibility="{Binding Workspace.Mode, Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Graph}" />

            <views:FilesView x:Name="FilesPane"
                             Visibility="{Binding Workspace.Mode, Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Files}" />

            <views:CodeView x:Name="CodePane"
                            Visibility="{Binding Workspace.Mode, Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Code}" />

            <!-- The conversation: the existing chat surface, unchanged in behaviour. -->
            <views:ChatView x:Name="ChatPane"
                            DataContext="{Binding Chat}"
                            Visibility="{Binding DataContext.Workspace.Mode,
                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                 Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Chat}" />

            <views:ModelsView x:Name="ModelsPane"
                              DataContext="{Binding ModelsPage}"
                              Visibility="{Binding DataContext.Workspace.Mode,
                                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                                   Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Models}" />

            <views:TasksView x:Name="TasksPane"
                             DataContext="{Binding Tasks}"
                             Visibility="{Binding DataContext.Workspace.Mode,
                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Tasks}" />

            <!-- Settings: the existing settings surface, as a full workspace mode. -->
            <views:SettingsView x:Name="SettingsPane"
                                DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.Workspace.Mode,
                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                     Converter={StaticResource WorkspaceModeEquals}, ConverterParameter=Settings}" />
        </Grid>
    </Grid>
</UserControl>
