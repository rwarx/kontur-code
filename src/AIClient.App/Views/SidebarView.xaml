<UserControl x:Class="AIClient.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kontur="clr-namespace:AIClient.App.Controls"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             xmlns:conv="clr-namespace:AIClient.App.Converters"
             xmlns:loc="clr-namespace:AIClient.App.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="800" d:DesignWidth="232"
             Background="{DynamicResource Brush.Surface1}"
             TextElement.Foreground="{DynamicResource Brush.TextPrimary}">

    <!--
        Navigation, the workspace, and the sessions - calm, narrow, and collapsible to a
        48px icon rail. The code-behind mirrors the collapse state into the panel widths;
        here every row simply hides its label, and the tooltips (always on) take over.
    -->
    <UserControl.Resources>
        <!-- See BindingProxy: a ContextMenu is not in this visual tree. -->
        <conv:BindingProxy x:Key="Root" Data="{Binding}" />

        <!-- One nav row. The nav vocabulary is icon + label, and the icon is always
             15px so the rail reads evenly when the labels are hidden. Collapsed, the
             icon centres in the row instead of hugging its hidden label's edge. -->
        <DataTemplate x:Key="NavItemTemplate">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Data.IsSidebarCollapsed, Source={StaticResource Root}}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <kontur:KonturIcon Kind="{Binding Icon}" Width="15" Height="15"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <TextBlock Text="{Binding Label}" Style="{StaticResource Type.Caption}" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding Data.IsSidebarCollapsed, Source={StaticResource Root},
                                                Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand + hide. The button does what Ctrl+B does - hides the bar outright -
              and the always-visible toggle in the title bar brings it back. -->
        <Grid Grid.Row="0" Margin="10,10,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="26" Height="26"
                        CornerRadius="5"
                        Background="{DynamicResource Brush.LogoPlate}"
                        Padding="4"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <Image Source="/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="{DynamicResource S.Sidebar.Section.Workspace}" Style="{StaticResource Type.Section}" Margin="9,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource KcButtonTool}" Width="24" Height="24"
                    Command="{Binding ToggleSidebarCommand}"
                    ToolTip="{DynamicResource S.Sidebar.Hide.ToolTip}">
                <kontur:KonturIcon Kind="CollapsePanel" Width="13" Height="13" />
            </Button>
        </Grid>

        <!-- New chat. Collapsed, the label goes and the plus centres in the rail. -->
        <Button Grid.Row="1" Margin="10,2,10,8"
                Padding="10,7" MinHeight="34"
                Command="{Binding NewChatCommand}" ToolTip="{DynamicResource S.Sidebar.NewChat.ToolTip}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource KcButtonPrimary}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <kontur:KonturIcon Kind="Plus" Width="14" Height="14"
                                   Foreground="{DynamicResource Brush.TextOnAccent}" />
                <TextBlock Text="{DynamicResource S.Sidebar.NewChat}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Button>

        <!-- Mode navigation. -->
        <ListBox x:Name="NavList" Grid.Row="2" Margin="6,0"
                 ItemContainerStyle="{StaticResource KcNavItem}"
                 ItemTemplate="{StaticResource NavItemTemplate}"
                 SelectionChanged="OnNavSelected"
                 KeyboardNavigation.DirectionalNavigation="Contained" />

        <!-- Workspace block: the folder, its two actions, and its health. In the rail
             the two actions survive as centred icon-only rows; the section title goes. -->
        <StackPanel Grid.Row="3" Margin="10,10,10,6">
            <TextBlock Text="{DynamicResource S.Sidebar.Section.Workspace}" Style="{StaticResource Type.Overline}" Margin="2,0,0,4"
                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
            <Button Padding="9,6" Margin="0,1"
                    Command="{Binding Workspace.OpenWorkspaceCommand}"
                    ToolTip="{Binding Workspace.WorkspaceRoot, FallbackValue={loc:Loc S.Sidebar.OpenFolder.Fallback}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource KcButtonGhost}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <kontur:KonturIcon Kind="Open" Width="14" Height="14" />
                    <TextBlock Text="{DynamicResource S.Sidebar.OpenFolder}" Style="{StaticResource Type.Caption}" Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Button>
            <Button Padding="9,6" Margin="0,1"
                    Command="{Binding Workspace.RefreshGraphCommand}"
                    ToolTip="{DynamicResource S.Sidebar.Refresh.ToolTip}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource KcButtonGhost}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <kontur:KonturIcon Kind="Refresh" Width="14" Height="14"
                                       Foreground="{DynamicResource Brush.AccentText}" />
                    <TextBlock Text="{DynamicResource S.Sidebar.RefreshGraph}" Style="{StaticResource Type.Caption}" Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Sessions. The whole block leaves the rail: a 48px column of clipped row
             fragments is exactly the noise collapse exists to remove. -->
        <Grid Grid.Row="4" Margin="0,2"
              Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource S.Sidebar.Section.Sessions}" Style="{StaticResource Type.Overline}"
                       Margin="12,0,0,4"
                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />

            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="10,0,10,6" MinHeight="28"
                     Style="{StaticResource KcInputPlaceholder}"
                     VerticalContentAlignment="Center"
                     Tag="{DynamicResource S.Sidebar.Search.Placeholder}"
                     Text="{Binding Sessions.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource S.Sidebar.Search.ToolTip}"
                     Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />

            <ListBox x:Name="SessionList" Grid.Row="2"
                     ItemsSource="{Binding Sessions.Sessions}"
                     SelectedItem="{Binding Sessions.SelectedSession}"
                     Margin="6,0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.ScrollChanged="OnSessionScrollChanged"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnSessionSelected"
                     Style="{StaticResource {x:Type ListBox}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="Margin" Value="1,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <kontur:KonturIcon Grid.Column="0" Kind="Pin" Width="11" Height="11"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" MinWidth="0"
                                        Visibility="{Binding DataContext.IsSidebarCollapsed, Source={StaticResource Root},
                                                             Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Caption}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}"
                                               Style="{StaticResource Type.Metadata}" />
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Type.Metadata}"
                                               Opacity="0.55" Margin="8,0,0,0" MaxWidth="130"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Open}" Command="{Binding Data.Sessions.OpenCommand, Source={StaticResource Root}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Rename}"
                                  Command="{Binding Data.Sessions.RenameCommand, Source={StaticResource Root}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Pin}"
                                  Command="{Binding Data.Sessions.TogglePinCommand, Source={StaticResource Root}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Delete}"
                                  Command="{Binding Data.Sessions.DeleteCommand, Source={StaticResource Root}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>

        <!-- Footer: settings, theme, palette. In the rail the trio stacks vertically -
             three 24px buttons do not fit a 48px column side by side. -->
        <Border Grid.Row="5" BorderBrush="{DynamicResource Brush.BorderFaint}" BorderThickness="0,1,0,0"
                Padding="6,6">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Orientation" Value="Vertical" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding ShowSettingsCommand}"
                        ToolTip="{DynamicResource S.Sidebar.Settings.ToolTip}">
                    <kontur:KonturIcon Kind="Settings" Width="14" Height="14" />
                </Button>
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding ToggleThemeCommand}"
                        ToolTip="{DynamicResource S.Sidebar.Theme.ToolTip}">
                    <!-- Sun in dark mode (click buys light), moon in light mode. The 90°
                         turn between them is the morphicon-congruent pair. -->
                    <kontur:MorphIcon First="Sun" Second="Moon"
                                      IsSecond="{Binding IsDarkTheme, Mode=OneWay}"
                                      Width="14" Height="14" />
                </Button>
                <Button Style="{StaticResource KcButtonTool}" Command="{Binding ToggleCommandPaletteCommand}"
                        ToolTip="{DynamicResource S.Sidebar.Palette.ToolTip}">
                    <kontur:KonturIcon Kind="Command" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
