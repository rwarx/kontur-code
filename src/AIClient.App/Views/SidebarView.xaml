<UserControl x:Class="AIClient.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             xmlns:conv="clr-namespace:AIClient.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="700" d:DesignWidth="280">

    <UserControl.Resources>
        <!-- See BindingProxy: a ContextMenu is not in this visual tree. -->
        <conv:BindingProxy x:Key="Root" Data="{Binding}" />
    </UserControl.Resources>

    <!--
        A workspace navigator, not a stack of buttons: one action (new chat), one filter
        (search), the recent sessions, and the tools that lead elsewhere.
    -->
    <Border Background="{DynamicResource BgSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- New Chat -->
            <ui:Button Grid.Row="0"
                       Margin="10,12,10,8"
                       Padding="11,9"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       CornerRadius="{StaticResource R8}"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}"
                       Content="{DynamicResource S.Sidebar.NewChat}"
                       ToolTip="{DynamicResource S.Sidebar.NewChat.ToolTip}"
                       Command="{Binding NewChatCommand}" />

            <!-- Search -->
            <ui:TextBox x:Name="SearchBox"
                        Grid.Row="1"
                        Margin="10,0,10,10"
                        PlaceholderText="{DynamicResource S.Sidebar.Search.Placeholder}"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        Text="{Binding Sessions.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{DynamicResource S.Sidebar.Search.ToolTip}" />

            <TextBlock Grid.Row="2"
                       Text="{DynamicResource S.Sidebar.Section.Recent}"
                       Style="{StaticResource SectionLabel}"
                       Margin="14,2,14,4" />

            <!-- Session list -->
            <Grid Grid.Row="3">
                <ListBox x:Name="SessionList"
                         ItemsSource="{Binding Sessions.Sessions}"
                         SelectedItem="{Binding Sessions.SelectedSession}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="6,0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.ScrollChanged="OnSessionScrollChanged"
                         SelectionChanged="OnSessionSelected"
                         Visibility="{Binding Sessions.IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="9,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Pin24"
                                               FontSize="12"
                                               Margin="0,2,7,0"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text=" · " />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text="{Binding Preview}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right-click rather than always-visible buttons: the list is
                                     narrow and three icons per row would crowd out the title. -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Open}"
                                                  Command="{Binding Data.Sessions.OpenCommand, Source={StaticResource Root}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Rename}"
                                                  Command="{Binding Data.Sessions.RenameCommand, Source={StaticResource Root}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Pin}"
                                                  Command="{Binding Data.Sessions.TogglePinCommand, Source={StaticResource Root}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource S.Sidebar.Menu.Delete}"
                                                  Command="{Binding Data.Sessions.DeleteCommand, Source={StaticResource Root}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state, distinguishing "no chats yet" from "nothing matched". -->
                <TextBlock Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center"
                           Margin="20"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Text="{Binding Sessions.EmptyMessage}"
                           Visibility="{Binding Sessions.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <ui:ProgressRing IsIndeterminate="True"
                                 Width="22" Height="22"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Visibility="{Binding Sessions.IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Tools: the places that are not a conversation. -->
            <StackPanel Grid.Row="4" Margin="10,4,10,10">
                <Border Style="{StaticResource Hairline}" Margin="4,0,4,8" />

                <ui:Button Style="{StaticResource SidebarButton}"
                           Icon="{ui:SymbolIcon Flowchart24}"
                           Content="{DynamicResource S.Sidebar.Canvas}"
                           ToolTip="{DynamicResource S.Sidebar.Canvas.ToolTip}"
                           Command="{Binding ShowCanvasCommand}" />

                <ui:Button Style="{StaticResource SidebarButton}"
                           Icon="{ui:SymbolIcon Settings24}"
                           Content="{DynamicResource S.Sidebar.Settings}"
                           ToolTip="{DynamicResource S.Sidebar.Settings.ToolTip}"
                           Command="{Binding ShowSettingsCommand}" />

                <ui:Button Style="{StaticResource SidebarButton}"
                           Icon="{ui:SymbolIcon WeatherMoon24}"
                           Content="{DynamicResource S.Sidebar.ToggleTheme}"
                           Command="{Binding ToggleThemeCommand}" />

                <ui:Button Style="{StaticResource SidebarButton}"
                           Icon="{ui:SymbolIcon Keyboard24}"
                           Content="{DynamicResource S.Sidebar.Palette}"
                           ToolTip="{DynamicResource S.Sidebar.Palette.ToolTip}"
                           Command="{Binding ToggleCommandPaletteCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
