<UserControl x:Class="AIClient.App.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kontur="clr-namespace:AIClient.App.Controls"
             xmlns:motion="clr-namespace:AIClient.App.Controls"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel}"
             d:DesignHeight="420" d:DesignWidth="560">

    <!--
        The palette is an overlay, not a window: a separate Window steals activation, drops
        the Mica backdrop and flickers on open. A scrim over the shell dismisses on click
        and keeps the app looking like one surface.

        Opening is one orchestrated moment - the panel settles from 2% large while the
        scrim the shell draws beneath it does its work - and then the palette is still.
    -->
    <Grid Background="{DynamicResource Brush.Scrim}"
          MouseLeftButtonDown="OnScrimClicked"
          motion:Motion.Show="Fade">

        <Border MaxWidth="620"
                MaxHeight="440"
                Margin="0,110,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                CornerRadius="{StaticResource Radius.LG}"
                Background="{DynamicResource Brush.Surface3}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1"
                MouseLeftButtonDown="OnPanelClicked"
                motion:Motion.Show="Settle">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.BorderFaint}" BorderThickness="0,0,0,1"
                        Margin="8,8,8,0" Padding="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <kontur:KonturIcon Grid.Column="0" Kind="Search" Width="15" Height="15"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox Grid.Column="1"
                                 x:Name="QueryBox"
                                 Style="{StaticResource KcInputBare}"
                                 FontSize="15"
                                 Padding="9,2"
                                 MinHeight="30"
                                 VerticalContentAlignment="Center"
                                 PreviewKeyDown="OnQueryKeyDown"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <ListBox x:Name="EntryList"
                         Grid.Row="1"
                         Margin="4,0,4,4"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseLeftButtonUp="OnEntryClicked">

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource Type.Metadata}"
                                               TextOptions.TextFormattingMode="Display"
                                               FontWeight="SemiBold"
                                               Margin="10,10,0,4"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Type.Keycap}"
                                        Visibility="{Binding Shortcut, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock Style="{StaticResource Type.KeycapText}"
                                               Text="{Binding Shortcut}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- No match: the palette is a dead end otherwise, with no hint that the
                     filter is what emptied it. -->
                <TextBlock Grid.Row="1"
                           Margin="0,30"
                           TextAlignment="Center"
                           Style="{StaticResource SubtleText}"
                           Text="{DynamicResource S.Palette.NoMatches}"
                           Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />

                <Border Grid.Row="2"
                        Padding="12,7"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Brush.BorderFaint}">
                    <TextBlock Style="{StaticResource Type.Metadata}"
                               Text="{DynamicResource S.Palette.Hints}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
