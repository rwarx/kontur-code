<UserControl x:Class="AIClient.App.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AIClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel}"
             d:DesignHeight="420" d:DesignWidth="560">

    <!--
        The palette is an overlay, not a window: a separate Window steals activation, drops
        the Mica backdrop and flickers on open. A scrim over the shell dismisses on click
        and keeps the app looking like one surface.
    -->
    <Grid Background="#66000000" MouseLeftButtonDown="OnScrimClicked">

        <Border MaxWidth="620"
                MaxHeight="440"
                Margin="0,110,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                CornerRadius="10"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                MouseLeftButtonDown="OnPanelClicked">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBox x:Name="QueryBox"
                            Grid.Row="0"
                            Margin="10"
                            FontSize="15"
                            PlaceholderText="Type a command…"
                            Icon="{ui:SymbolIcon Search24}"
                            PreviewKeyDown="OnQueryKeyDown"
                            Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

                <ListBox x:Name="EntryList"
                         Grid.Row="1"
                         Margin="4,0,4,4"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseLeftButtonUp="OnEntryClicked">

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="10,10,0,4"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge}"
                                        HorizontalAlignment="Right"
                                        Padding="6,2"
                                        Visibility="{Binding Shortcut, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock Style="{StaticResource BadgeText}"
                                               FontFamily="{StaticResource CodeFont}"
                                               Text="{Binding Shortcut}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- No match: the palette is a dead end otherwise, with no hint that the
                     filter is what emptied it. -->
                <TextBlock Grid.Row="1"
                           Margin="0,30"
                           TextAlignment="Center"
                           Style="{StaticResource SubtleText}"
                           Text="No matching commands."
                           Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />

                <Border Grid.Row="2"
                        Padding="12,7"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <TextBlock Style="{StaticResource SubtleText}"
                               FontSize="11"
                               Text="↑↓ to navigate · Enter to run · Esc to close" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
