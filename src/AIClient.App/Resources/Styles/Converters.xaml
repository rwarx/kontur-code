<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AIClient.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:StringToVisibilityConverter x:Key="EmptyStringToVisibility" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:StringToBoolConverter x:Key="StringToBool" />
    <conv:UserAlignmentConverter x:Key="UserAlignment" />
    <conv:RelativeTimeConverter x:Key="RelativeTime" />
    <conv:UsageSummaryConverter x:Key="UsageSummary" />
    <conv:ContextWindowConverter x:Key="ContextWindow" />
    <conv:PriceConverter x:Key="Price" />
    <conv:IntToDoubleConverter x:Key="IntToDouble" />
    <conv:IntToTextConverter x:Key="IntToText" />
    <conv:EqualityConverter x:Key="Equality" />
    <conv:WorkspaceModeEqualsConverter x:Key="WorkspaceModeEquals" />
    <conv:NodeCountToVisibilityConverter x:Key="NodeCountToVisibility" />
    <conv:ContextPanelModeLabelConverter x:Key="ContextPanelModeLabel" />
    <conv:NodeKindIconConverter x:Key="NodeKindToIcon" />
    <conv:ThemeModeLabelConverter x:Key="ThemeModeLabel" />

    <!-- Context panel -->
    <conv:TokenShareConverter x:Key="TokenShare" />
    <conv:TokenCountConverter x:Key="TokenCount" />
    <conv:PercentConverter x:Key="Percent" />
    <conv:BandShareConverter x:Key="BandShare" />
    <conv:CostConverter x:Key="Cost" />
    <conv:AbsoluteTimeConverter x:Key="AbsoluteTime" />

</ResourceDictionary>
