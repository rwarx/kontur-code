<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Legacy chat metrics. The design system (Resources/Design/*) owns colours, type and
        controls; this dictionary keeps only what the transcript templates still name and
        what has no token equivalent.

        The brush keys this file used to define (diff washes, the approval amber, the syntax
        palette) resolve into Design/Colors.xaml now; the light-theme overrides keep winning
        through AppThemeService's late merge, because that dictionary is appended after this
        one at runtime.
    -->
    <sys:Double x:Key="ContentMaxWidth">860</sys:Double>
    <CornerRadius x:Key="CardCorner">6</CornerRadius>

    <FontFamily x:Key="CodeFont">Cascadia Code, Consolas, Courier New</FontFamily>

    <!--
        User messages sit in a tinted bubble; assistant messages run full width with no
        container. Boxing a long answer in a card wastes horizontal space and makes code
        blocks harder to read, which is the opposite of what a coding-focused client wants.
    -->
    <Style x:Key="UserMessageCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MaxWidth" Value="620" />
    </Style>

    <!--
        Two tints rather than two text colours. A translucent wash over whatever the theme already
        painted stays legible in both light and dark, which a fixed green on white does not - and the
        diff in an approval card is the one piece of text in this app a user has to read carefully
        before answering. The leading + and - carry the same information for anyone who cannot tell
        the two hues apart.
    -->
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#332EA043" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#33F85149" />

    <!--
        The gate's accent. Amber rather than red: every question it asks is about something
        irreversible, but most of them are a file the user asked to have edited, and a card that
        looks like an error teaches them to dismiss errors.
    -->
    <SolidColorBrush x:Key="ApprovalAccentBrush" Color="#E3A008" />

    <!-- The well a code block sits in, one step below the transcript surface. -->
    <Style x:Key="CodeBlockContainer" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFaint}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Quiet metadata line: hints, counts, timestamps. -->
    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Interface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Attachment chips ride above the text they were sent with. -->
    <Style x:Key="AttachmentChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFaint}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
