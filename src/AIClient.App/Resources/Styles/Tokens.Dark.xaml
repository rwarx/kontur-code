<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Kontur Code design tokens - DARK (the product's primary theme).

        One palette the whole shell is built from: a stepped neutral background (never pure
        black), hairline borders, a three-step text ramp, and one accent supplied by Windows
        through WPF-UI. Every key here is redefined with the same name in Tokens.Light.xaml -
        the two dictionaries swap as a unit in AppThemeService, which is what makes the theme
        switch live.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="#161619" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#1D1D21" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#25252A" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#2A2A30" />
    <SolidColorBrush x:Key="BgActiveBrush" Color="#313139" />
    <SolidColorBrush x:Key="BgInsetBrush" Color="#101013" />

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282E" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A3A42" />

    <!-- Text ramp -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDF1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9C9CA7" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#68686F" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F8514A" />

    <!-- The gate's accent. Amber, not red: a card that looks like an error teaches the user
         to dismiss errors. Slightly deeper in light so it keeps contrast on white. -->
    <SolidColorBrush x:Key="ApprovalAccentBrush" Color="#E3A008" />
    <SolidColorBrush x:Key="ApprovalSoftBrush" Color="#24E3A008" />

    <!-- Diff tints. Translucent washes over whatever the theme painted stay legible in
         both themes; the dedicated text colours keep added/removed words readable. -->
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#2E2EA043" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#2EF85149" />
    <SolidColorBrush x:Key="DiffAddedTextBrush" Color="#7EE29B" />
    <SolidColorBrush x:Key="DiffRemovedTextBrush" Color="#FF8C88" />

    <!-- Syntax colours for code blocks (dark set, Visual Studio heritage). -->
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#569CD6" />
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#4EC9B0" />
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#CE9178" />
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B5CEA8" />
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#6A9955" />
    <SolidColorBrush x:Key="SyntaxDirectiveBrush" Color="#C586C0" />
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#DCDCAA" />

</ResourceDictionary>
