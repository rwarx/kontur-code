<!--
    Kontur Code design system — icon drawings.

    One 16×16 grid, stroke-only figures, round caps and joins, ~1.5px weight at design
    size. The geometry resources are frozen StreamGeometries shared by every instance of
    an icon. KonturIcon resolves "Icon.<Kind>" from this dictionary.

    Conventions, because they are what make forty drawings look like one set:
      - 1.5 units of margin between figure and the 16px edge, so nothing kisses its box.
      - Fills only where the shape is genuinely solid (Play); everything else is a stroke.
      - Zero-length segments ("h0.01") draw as dots under round caps - a clean way to get
        point markers without a second geometry type.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Identity. The Kontur mark: a stem and a broken chevron - reads as a K, as a
         bracket, and at 20px as a logo, which is the whole job. -->
    <StreamGeometry x:Key="Icon.Logo" po:Freeze="True">M4 2 V14 M12.5 2 L5.2 8 L12.5 14</StreamGeometry>

    <!-- Navigation -->
    <StreamGeometry x:Key="Icon.Chat" po:Freeze="True">M3 3 H13 V11 H7.5 L4.5 14 V11 H3 Z</StreamGeometry>
