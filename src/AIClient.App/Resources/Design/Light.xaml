<!--
    Kontur Code design system — the light palette.

    The same semantic token keys as Design/Colors.xaml, re-defined with light values.
    AppThemeService merges this dictionary last when the effective theme is Light, so these
    definitions win over the dark ones for every DynamicResource consumer; removing it
    returns the app to the dark palette. No view references this file directly - it only
    ever knows the token, never the theme.

    The mood is a soft, cool gray, not stark white: surfaces sit a step below paper so 1px
    borders and small luminance steps still carry the structure, the way they do in the dark
    theme. Accent stays teal, deepened for contrast on light ground; it is still spent only
    where the eye should go - selection, activity, AI.

    Frozen for the same reason as the dark palette: the canvas renderer reads these brushes
    on every draw, and a frozen brush skips change notification.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Surfaces. Base sits below paper; raised surfaces climb toward white. -->

    <SolidColorBrush x:Key="Brush.Surface0" Color="#ECEEF1" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="#F2F4F6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="#F7F8FA" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E4E7EC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#D8DCE3" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceSelected" Color="#E6E8EC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#E3E6EA" po:Freeze="True" />

    <!-- Structure. Faint separates content inside one surface; Border separates surfaces. -->

    <SolidColorBrush x:Key="Brush.BorderFaint" Color="#E6E9ED" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D6DAE0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#BAC1CB" po:Freeze="True" />

    <!-- Text -->

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1B1E23" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#565E6A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#89909C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" po:Freeze="True" />

    <!-- The brand plate keeps its dark ground in the light theme too (see Colors.xaml):
         the white logo needs it, and the contrast is what makes the badge pop on paper. -->
    <SolidColorBrush x:Key="Brush.LogoPlate" Color="#1B1E23" po:Freeze="True" />

    <!-- Accent. Ink on paper: the monochrome accent of the dark palette, inverted for
         light ground. White on white would vanish, so the accent voice here is near-black;
         it still marks exactly the same places - selection, activity, AI, focus. -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#1B1E23" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#26292E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#ECEEF1" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#B4B9C2" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#3A3E45" po:Freeze="True" />

    <!-- Semantics. Soft variants are the fill behind the strong stroke. -->

    <SolidColorBrush x:Key="Brush.Success" Color="#2E9E5B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#DEF2E6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B37F1E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#F5ECD6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error" Color="#CB423C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ErrorSoft" Color="#F7DFDD" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Running" Color="#B37F1E" po:Freeze="True" />

    <!-- Canvas. Background sits a step below the panels so it reads as an inset well;
         the grid is a faint tint of it, the major grid a touch stronger. -->

    <SolidColorBrush x:Key="Brush.CanvasBackground" Color="#E7EAEE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.CanvasGrid" Color="#D8DCE2" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.CanvasGridMajor" Color="#CBD1D8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.MarqueeStroke" Color="#1B1E23" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.MarqueeFill" Color="#DFE2E6" po:Freeze="True" />

    <!-- Nodes. Body is paper on the inset canvas; the 1px border carries the edge. -->

    <SolidColorBrush x:Key="Brush.NodeBody" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBodyHover" Color="#F4F6F8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBodySelected" Color="#E6E8EC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBorder" Color="#D3D8DF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBorderSelected" Color="#1B1E23" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeTitle" Color="#1B1E23" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeMeta" Color="#6C7480" po:Freeze="True" />

    <!-- Node kinds. The accent stripe / glyph tint per node type. Darkened from the dark
         palette so each still reads against a white node body. -->

    <SolidColorBrush x:Key="Brush.Node.File" Color="#67717E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Folder" Color="#A2723C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Module" Color="#5E6C7D" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Service" Color="#3A3E44" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Interface" Color="#2A88A0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Data" Color="#AC6733" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.View" Color="#6A54A0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Test" Color="#46689E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Plan" Color="#B0851E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Task" Color="#767E8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Agent" Color="#AF5E3D" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Model" Color="#8592A1" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.External" Color="#838B97" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Note" Color="#767E8A" po:Freeze="True" />

    <!-- Edges. The connector between nodes; selected picks up the accent. -->

    <SolidColorBrush x:Key="Brush.Edge" Color="#C4CBD3" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.EdgeHover" Color="#99A2AE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.EdgeSelected" Color="#1B1E23" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.EdgeDimmed" Color="#E1E5EA" po:Freeze="True" />

    <!-- Overlays. Scrim dims the app behind a modal; lighter here than on the dark ground. -->

    <SolidColorBrush x:Key="Brush.Scrim" Color="#26000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OverlayBackground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OverlayPanel" Color="#E6FFFFFF" po:Freeze="True" />

    <!-- Legacy aliases. Diff washes keep their alpha; syntax colours switch to a light
         editor scheme so code reads on paper rather than on the dark editor ground. -->

    <SolidColorBrush x:Key="DiffAddedBrush" Color="#332EA043" po:Freeze="True" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#33F85149" po:Freeze="True" />
    <SolidColorBrush x:Key="ApprovalAccentBrush" Color="#B37F1E" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#0000FF" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#267F99" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A31515" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#098658" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#008000" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxDirectiveBrush" Color="#AF00DB" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#795E26" po:Freeze="True" />

</ResourceDictionary>
