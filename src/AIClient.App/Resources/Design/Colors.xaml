<!--
    Kontur Code design system — colour tokens.

    One dark-first palette expressed as semantic resources. Views never hold a literal
    colour: they bind to a token here, so the whole surface can be re-tuned (or
    re-themed, via Design/Light.xaml overriding the same keys) without touching a view.

    Levels are deliberately close together. The interface is meant to read as one deep
    neutral-grey surface with structure carried by 1px borders and small luminance steps,
    not by strongly separated plates. Accent is spent only where the product wants the eye
    to go: selection, activity, AI. Everything else is neutral.

    All brushes are frozen: they are read thousands of times a second by the canvas
    renderer, and a frozen brush skips change notification on every draw.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Surfaces -->

    <SolidColorBrush x:Key="Brush.Surface0" Color="#1A1B1D" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="#1F2022" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="#26272A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="#2E2F33" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#35363B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#3C3D43" po:Freeze="True" />
    <!-- Where selection is a state, not a colour statement: a neutral raised tint. -->
    <SolidColorBrush x:Key="Brush.SurfaceSelected" Color="#2B2D32" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#141517" po:Freeze="True" />

    <!-- Structure. Faint separates content inside one surface; Border separates surfaces. -->

    <SolidColorBrush x:Key="Brush.BorderFaint" Color="#292A2E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border" Color="#34353A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#45464D" po:Freeze="True" />

    <!-- Text -->

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E8EAEE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A4AB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E7178" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#17181B" po:Freeze="True" />

    <!-- The brand plate: the small rounded square the logo sits on. The logo itself is
         white, so its plate stays dark in BOTH themes - it is the one deliberately
         theme-independent surface in the app, which is what makes the mark recognisable
         in both. -->
    <SolidColorBrush x:Key="Brush.LogoPlate" Color="#202126" po:Freeze="True" />

    <!-- Accent. Monochrome white: the one voice the product is loud with, and only in
         the places the design audit lists - selection, activity, AI, focus. White needs
         no hue to carry those, which is what keeps every panel calm. Hover dims rather
         than brightens - white cannot get brighter, and the inverse reads the same way
         a physical key does when pressed. -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2A2C31" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#B9BEC6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#D8DBDF" po:Freeze="True" />

    <!-- Semantics -->

    <SolidColorBrush x:Key="Brush.Success" Color="#43B971" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#1B2A21" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D9A03F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#2E2517" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error" Color="#E0564F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ErrorSoft" Color="#2F1B1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Running" Color="#D9A03F" po:Freeze="True" />

    <!-- The canvas is its own surface: darker than everything so spatial content reads as
         sitting inside the interface rather than on a panel of it. -->

    <SolidColorBrush x:Key="Brush.CanvasBackground" Color="#121315" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.CanvasGrid" Color="#1E1F22" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.CanvasGridMajor" Color="#26272A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.MarqueeStroke" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.MarqueeFill" Color="#232428" po:Freeze="True" />

    <!-- Nodes. A body wash plus a per-kind stroke. Strokes are muted on purpose: at 500
         visible nodes, saturated borders turn the canvas into confetti; kinds need to be
         distinguishable at a glance, not shouting. -->

    <SolidColorBrush x:Key="Brush.NodeBody" Color="#232427" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBodyHover" Color="#2A2B2F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBodySelected" Color="#2B2D32" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBorder" Color="#33343A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeBorderSelected" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeTitle" Color="#E8EAEE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.NodeMeta" Color="#8A93A0" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Node.File" Color="#8B94A0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Folder" Color="#B58A5C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Module" Color="#8B95A3" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Service" Color="#E4E7EB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Interface" Color="#55C0D6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Data" Color="#C98B5C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.View" Color="#9C86C9" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Test" Color="#7B93C9" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Plan" Color="#E0B04F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Task" Color="#C0C7D0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Agent" Color="#D98B6B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Model" Color="#A7B2C0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.External" Color="#6E7681" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Node.Note" Color="#A8B0BA" po:Freeze="True" />

    <!-- Edges are secondary by decree: thin, quiet, never competing with nodes. -->

    <SolidColorBrush x:Key="Brush.Edge" Color="#39404B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.EdgeHover" Color="#5A6472" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.EdgeSelected" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.EdgeDimmed" Color="#23282F" po:Freeze="True" />

    <!-- Overlay scrims and palette surfaces -->

    <SolidColorBrush x:Key="Brush.Scrim" Color="#66000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OverlayBackground" Color="#26272A" po:Freeze="True" />
    <!-- Floating chrome over the canvas itself (toolbar, minimap, chips): the panel colour
         at 80% so the space reads through, without a blur the renderer would pay for. -->
    <SolidColorBrush x:Key="Brush.OverlayPanel" Color="#CC1F2022" po:Freeze="True" />

    <!--
        Legacy aliases. Settings, the first-run wizard and the markdown templates were
        written against the old Shared.xaml keys; they now resolve here so the old
        dictionary can eventually go away without a big-bang edit of every view.
    -->
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#332EA043" po:Freeze="True" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#33F85149" po:Freeze="True" />
    <SolidColorBrush x:Key="ApprovalAccentBrush" Color="#D9A03F" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#569CD6" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#4EC9B0" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#CE9178" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B5CEA8" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#6A9955" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxDirectiveBrush" Color="#C586C0" po:Freeze="True" />
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#DCDCAA" po:Freeze="True" />

</ResourceDictionary>
