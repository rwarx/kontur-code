<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIClient.Avalonia.ViewModels"
             x:Class="AIClient.Avalonia.Views.ChatPane"
             x:DataType="vm:ChatPaneViewModel">

    <!--
        The chat surface of this phase: compact, streaming, and aware of the canvas
        selection through the chip above the composer. A deliberately narrow surface -
        agent tool cards, attachments and markdown rendering are the parity pass.
    -->

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">

        <!-- Context chip -->
        <Border Grid.Row="0" IsVisible="{Binding SelectionChip, Converter={x:Static ObjectConverters.IsNotNull}}"
                HorizontalAlignment="Left" Margin="14,10,14,0" Padding="10,4" CornerRadius="12"
                Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="{Binding SelectionChip}" FontSize="11"
                       Foreground="{DynamicResource AccentBrush}" />
        </Border>

        <!-- Transcript -->
        <ScrollViewer Grid.Row="1" x:Name="TranscriptScroll" Margin="0,8,0,0"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Messages}" Margin="14,0,14,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="…" FontSize="13" IsVisible="{Binding IsStreaming}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Composer -->
        <Border Grid.Row="2" Margin="14,4,14,12" Padding="10,8" CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="ComposerBox"
                         Text="{Binding Draft}"
                         Watermark="Ask about the project…"
                         AcceptsReturn="False" BorderThickness="0" Background="Transparent" />
                <Button Grid.Column="1" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                        Padding="12,5" Content="Send" />
                <Button Grid.Column="2" Command="{Binding StopCommand}"
                        IsVisible="{Binding IsStreaming}" Padding="10,5" Content="Stop" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
