<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIClient.Avalonia.ViewModels"
             x:Class="AIClient.Avalonia.Views.InspectorPane"
             x:DataType="vm:InspectorViewModel">

    <!--
        The context surface. Nothing selected: not here at all - the canvas uses the width.
        One node: its facts and relations. A band of nodes: the kind breakdown and the
        actions that make sense for a band.
    -->

    <ScrollViewer>
        <StackPanel Margin="14,12,14,16" Spacing="10">

            <!-- Head -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Glyph}" FontSize="14"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Headline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding KindLabel}" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}" />

            <!-- Status / origin -->
            <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource NoticeBrush}"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding OriginText}" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       IsVisible="{Binding OriginText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Button x:Name="RevealButton" Content="Reveal file" HorizontalAlignment="Left" Padding="10,5"
                    IsVisible="{Binding HasSource}" />

            <!-- Multi-select breakdown -->
            <ItemsControl ItemsSource="{Binding KindBreakdown}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Relations -->
            <TextBlock Text="Outgoing" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       IsVisible="{Binding IsSingle}" />
            <ItemsControl ItemsSource="{Binding Outgoing}" IsVisible="{Binding IsSingle}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="relation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{Binding Glyph}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Incoming" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       IsVisible="{Binding IsSingle}" />
            <ItemsControl ItemsSource="{Binding Incoming}" IsVisible="{Binding IsSingle}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="relation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{Binding Glyph}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Facts -->
            <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding IsSingle}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding Label}" FontSize="11" Width="110"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Value}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="150" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- History -->
            <TextBlock Text="History" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       IsVisible="{Binding IsSingle}" />
            <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding IsSingle}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding When}" FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- AI actions -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                <Button x:Name="AskButton" Content="Ask" Padding="10,5" />
                <Button x:Name="ExplainButton" Content="Explain" Padding="10,5" />
                <Button x:Name="ProblemsButton" Content="Problems" Padding="10,5" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.relation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.relation:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
