<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIClient.Avalonia.ViewModels"
             x:Class="AIClient.Avalonia.Views.SettingsPane"
             x:DataType="vm:SettingsPaneViewModel">

    <!-- The first-phase settings surface: theme and provider keys. -->

    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24,20" Spacing="14" HorizontalAlignment="Left">

            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <!-- Theme -->
            <StackPanel Spacing="6">
                <TextBlock Text="Theme" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberBinding="{Binding Label}"
                          MinWidth="220" />
            </StackPanel>

            <!-- Providers -->
            <StackPanel Spacing="6" Margin="0,10,0,0">
                <TextBlock Text="Providers" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ListBox ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedProvider}"
                         MinHeight="120" MaxHeight="220" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding State}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Key entry -->
            <StackPanel Spacing="8" IsVisible="{Binding SelectedProvider, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding SelectedProvider.Name}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding ApiKeyInput}"
                         Watermark="API key"
                         PasswordChar="•"
                         MaxWidth="420" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SaveKeyCommand}" Content="Save key" Padding="12,6" />
                    <Button Command="{Binding TestConnectionCommand}" Content="Test" Padding="12,6" />
                    <Button Command="{Binding RemoveKeyCommand}" Content="Remove" Padding="12,6" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
