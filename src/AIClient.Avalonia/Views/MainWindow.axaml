<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIClient.Avalonia.ViewModels"
        xmlns:v="using:AIClient.Avalonia.Views"
        x:Class="AIClient.Avalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Kontur Code"
        Width="1380" Height="860"
        MinWidth="940" MinHeight="600"
        Background="{DynamicResource BgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        FontFamily="Segoe UI, Inter"
        FontSize="13">

    <!--
        The shell. Custom chrome: the top row is ours - logo, workspace, window buttons -
        and the three panes share the space under it. The palette overlays everything;
        the inspector lives inside the canvas view, where the selection it describes is.
    -->

    <Grid RowDefinitions="40,*">
        <!-- Title bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SurfaceBrush}">
            <Panel Grid.Column="0" Name="DragArea" Margin="14,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="◇" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

            <Panel Grid.Column="3" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Name="MinimizeButton" Classes="chrome" Width="44" Click="OnMinimize">
                        <Path Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" Data="M 4 8 L 12 8" />
                    </Button>
                    <Button Name="MaximizeButton" Classes="chrome" Width="44" Click="OnMaximize">
                        <Path Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"
                              Data="M 4 4 L 12 4 L 12 12 L 4 12 Z" />
                    </Button>
                    <Button Name="CloseButton" Classes="chrome close" Width="44" Click="OnClose">
                        <Path Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" Data="M 5 5 L 11 11 M 11 5 L 5 11" />
                    </Button>
                </StackPanel>
            </Panel>
        </Grid>

        <!-- Main area -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,1,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarOpen}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Width="224">
                    <Button Grid.Row="0" Command="{Binding Chat.NewChatCommand}"
                            Margin="10,12,10,6" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="＋" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="New chat" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Row="1" Text="{Binding Chat.SearchQuery}" Watermark="Search chats"
                             Margin="10,0,10,8" />

                    <ListBox Grid.Row="2" Name="SessionsList" ItemsSource="{Binding Chat.Sessions}"
                             SelectedItem="{Binding Chat.SelectedSession}" Margin="6,0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Panel Margin="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="◇" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <Button Classes="ghost tiny" Content="✕" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Opacity="0.55"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Chat.DeleteSessionCommand}"
                                            CommandParameter="{Binding}" />
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="10,6,10,12" Spacing="4">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                                Command="{Binding ShowChatCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="◇" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="Chat" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                                Command="{Binding ShowCanvasCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="▦" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="Canvas" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                                Command="{Binding ShowSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚙" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource StrokeSubtleBrush}" IsVisible="{Binding IsSidebarOpen}" />

            <!-- Workspace -->
            <Panel Grid.Column="2">
                <v:ChatPane IsVisible="{Binding IsChatVisible}" DataContext="{Binding Chat}" />
                <v:SettingsPane IsVisible="{Binding IsSettingsVisible}" DataContext="{Binding Settings}" />
                <v:CanvasView IsVisible="{Binding IsCanvasVisible}" DataContext="{Binding Canvas}" />

                <!-- Command palette -->
                <Panel IsVisible="{Binding IsPaletteOpen}">
                    <Panel Background="#66000000" />
                    <v:CommandPaletteView />
                </Panel>
            </Panel>
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E0B0413F" />
        </Style>
        <Style Selector="Button.ghost.tiny">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Styles>
</Window>
