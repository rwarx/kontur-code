<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:AIClient.Avalonia.ViewModels.Canvas"
             xmlns:r="using:AIClient.Avalonia.Rendering"
             xmlns:v="using:AIClient.Avalonia.Views"
             x:Class="AIClient.Avalonia.Views.CanvasView"
             x:DataType="vmc:CanvasViewModel">

    <!--
        The canvas page. One surface draws everything; around it sit the toolbar, the
        status strip, the inspector (which follows the selection), and the code panel
        (which appears when a node's file is opened). The right column is either the
        inspector or the code panel, never both at once.
    -->

    <Grid RowDefinitions="34,*,26" ColumnDefinitions="*,300">

        <!-- Breadcrumb -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Panel VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="{Binding Breadcrumb}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding Notice}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"
                           Foreground="{DynamicResource NoticeBrush}"
                           IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Panel>
        </Border>

        <!-- Surface -->
        <Panel Grid.Row="1" Grid.Column="0">
            <r:CanvasRenderSurface x:Name="Surface" />

            <!-- Empty state -->
            <Panel IsVisible="{Binding IsEmpty}" Background="Transparent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
                    <TextBlock Text="No project indexed yet" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding WorkspaceName}" />
                    <Button Command="{Binding IndexWorkspaceCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Padding="14,7">
                        <TextBlock Text="Open a project folder" />
                    </Button>
                </StackPanel>
            </Panel>

            <!-- Indexing pill -->
            <Border IsVisible="{Binding IsIndexing}" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,10,0,0" Padding="12,5" CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1">
                <TextBlock Text="{Binding GraphStatus}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="12,0,0,12" Spacing="6">
                <Button Command="{Binding ZoomOutCommand}" Width="30" Height="28" Content="−" />
                <Button Command="{Binding ZoomInCommand}" Width="30" Height="28" Content="＋" />
                <Button Command="{Binding ResetViewCommand}" Height="28" Content="100%" ToolTip.Tip="Reset zoom" />
                <Button Command="{Binding FitToContentCommand}" Height="28" Content="Fit" ToolTip.Tip="Fit the graph to the window" />
                <Button Command="{Binding AutoLayoutCommand}" Height="28" Content="Tidy"
                        ToolTip.Tip="Arrange the cards nobody has placed by hand" />
            </StackPanel>

            <!-- Status, right -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                    Padding="10,4" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding GraphStatus}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding SelectionStatus}" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- Right column: the code panel when open, otherwise the inspector -->
        <Panel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1">
            <Border IsVisible="{Binding Code.IsOpen}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,8,4">
                        <TextBlock Text="{Binding Code.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost tiny" Content="✕" Command="{Binding Code.CloseCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Code.Path}" FontSize="11" Margin="12,0,12,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding Code.Detail}" FontSize="11" Margin="12,2,12,6"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBox Grid.Row="3" Text="{Binding Code.Text}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" Margin="8,0,8,8"
                             FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" />
                    <TextBlock Grid.Row="4" Text="{Binding Code.Error}" FontSize="12" Margin="12,0,12,10"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding Code.HasError}" />
                </Grid>
            </Border>

            <v:InspectorPane IsVisible="{Binding !Code.IsOpen}" />
        </Panel>

        <!-- Status strip -->
        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" Spacing="16">
                <TextBlock Text="{Binding WorkspaceName}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding ZoomText}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding GraphStatus}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
