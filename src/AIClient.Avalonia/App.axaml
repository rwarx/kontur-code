<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIClient.Avalonia.App"
             RequestedThemeVariant="Dark">

    <!--
        Theme tokens for the whole shell. Views bind to these names only, so a light/dark
        switch is a variant change and never a view change. The palette is deliberately
        quiet: one background step for surfaces, one hairline stroke, three text levels,
        one accent. The kind colours of the canvas live in CanvasKindVisuals and stay
        theme-independent on purpose.
    -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBrush">#FF141416</SolidColorBrush>
                    <SolidColorBrush x:Key="CanvasBrush">#FF101012</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#FF1C1C1F</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceAltBrush">#FF242428</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBrush">#FF1C1C1F</SolidColorBrush>
                    <SolidColorBrush x:Key="StrokeBrush">#FF333338</SolidColorBrush>
                    <SolidColorBrush x:Key="StrokeSubtleBrush">#FF28282C</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimaryBrush">#FFE8E8EA</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryBrush">#FFA6A6AD</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiaryBrush">#FF6E6E76</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentBrush">#FF6CA4D8</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSoftBrush">#336CA4D8</SolidColorBrush>
                    <SolidColorBrush x:Key="NoticeBrush">#FFE3A008</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBrush">#FFE06C75</SolidColorBrush>
                    <SolidColorBrush x:Key="GridDotBrush">#33808080</SolidColorBrush>
                    <SolidColorBrush x:Key="MarqueeBrush">#26808080</SolidColorBrush>
                    <CornerRadius x:Key="CardCorner">7</CornerRadius>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush">#FFF7F7F8</SolidColorBrush>
                    <SolidColorBrush x:Key="CanvasBrush">#FFF1F1F3</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceAltBrush">#FFF0F0F2</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBrush">#FFFFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="StrokeBrush">#FFD8D8DC</SolidColorBrush>
                    <SolidColorBrush x:Key="StrokeSubtleBrush">#FFE6E6EA</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimaryBrush">#FF1B1B1E</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryBrush">#FF5C5C64</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiaryBrush">#FF94949C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentBrush">#FF3D7EBB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSoftBrush">#333D7EBB</SolidColorBrush>
                    <SolidColorBrush x:Key="NoticeBrush">#FFB07C05</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBrush">#FFC24850</SolidColorBrush>
                    <SolidColorBrush x:Key="GridDotBrush">#26808080</SolidColorBrush>
                    <SolidColorBrush x:Key="MarqueeBrush">#1A808080</SolidColorBrush>
                    <CornerRadius x:Key="CardCorner">7</CornerRadius>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

</Application>
