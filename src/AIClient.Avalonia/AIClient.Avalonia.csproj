<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AIClient.Avalonia</RootNamespace>
    <AssemblyName>AIClient.Avalonia</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <!--
    The Avalonia UI layer: the new desktop shell. It binds only to Application/Domain
    abstractions and references Infrastructure solely for DI composition, exactly like
    the WPF app next door. net10.0-windows until the DPAPI-bound Infrastructure is
    abstracted; nothing else in this project is Windows-specific.
  -->

  <ItemGroup>
    <ProjectReference Include="..\AIClient.Application\AIClient.Application.csproj" />
    <ProjectReference Include="..\AIClient.Domain\AIClient.Domain.csproj" />
    <ProjectReference Include="..\AIClient.Infrastructure\AIClient.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
